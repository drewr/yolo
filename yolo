    ]

main :: IO ()
main = do
  root <- yoloRoot
  args <- getArgs
  let isHelp = (`elem` ["help", "-h", "--help"])
  unless (maybe True isHelp (listToMaybe args)) migrateAgentSandboxState
  case args of
    "new" : rest -> cmdNew root rest
    "attach" : rest -> cmdAttach root rest
    "ssh" : rest -> cmdAttach root rest
    ["ls"] -> cmdLs root False
    ["ls", "--full"] -> cmdLs root True
    "logs" : rest -> cmdLogs root rest
    ["rm", name] -> cmdRm root name
    "build" : rest -> cmdBuild root rest
    ["sync-pins"] -> syncPins root
    "infra" : rest -> cmdInfra root rest
    [h] | isHelp h -> putStr usage
    _ -> hPutStr stderr usage >> exitWith (ExitFailure 2)

-- The repository: $YOLO_ROOT (the compiled yolo's wrapper defaults it to
-- the flake's source), else this script's directory, through any symlinks.
yoloRoot :: IO FilePath
yoloRoot = envNonEmpty "YOLO_ROOT" >>= maybe (takeDirectory <$> canonicalizePath $(location >>= lift . loc_filename)) pure

-- Commands that rewrite image/ (pins, flake.lock) need a checkout, not the
-- read-only copy a compiled yolo carries.
needCheckout :: FilePath -> String -> IO ()
needCheckout root what =
  when ("/nix/store/" `isPrefixOf` root) $
    die (what ++ " updates image/ in the repository; run it from a yolo checkout (./yolo) or set YOLO_ROOT to one")

----------------------------------------------------------------------------
-- Commands

cmdNew :: FilePath -> [String] -> IO ()
cmdNew root = \case
  [] -> die "usage: yolo new NAME [--backend docker|datum] [--agent HARNESS] [options]"
  name : rest0 -> do
    backend0 <- opt "BACKEND" "docker"
    harness0 <- opt "AGENT" "claude"
    let go b h acc = \case
          "--backend" : v : r -> go v h acc r
          "--agent" : v : r -> go b v acc r
          x : r -> go b h (acc ++ [x]) r
          [] -> (b, h, acc)
        (backend, harness, rest) = go backend0 harness0 [] rest0
    checkHarness harness
    _ <- sessionDir name
    b <- loadBackend root backend
    bNew b name harness rest

cmdAttach :: FilePath -> [String] -> IO ()
cmdAttach root = \case
  [] -> die "usage: yolo attach NAME [args...]"
  name : rest -> sessionBackend name >>= loadBackend root >>= \b -> bAttach b name rest

cmdLogs :: FilePath -> [String] -> IO ()
cmdLogs root = \case
  [] -> die "usage: yolo logs NAME [args...]"
  name : rest -> sessionBackend name >>= loadBackend root >>= \b -> bLogs b name rest

cmdRm :: FilePath -> String -> IO ()
cmdRm root name = sessionBackend name >>= loadBackend root >>= \b -> bRm b name

cmdLs :: FilePath -> Bool -> IO ()
cmdLs root full = do
  -- Datum is the source of truth for datum sessions: bring the local state
  -- in line with it first, wherever each session was made.
  hasDatumctl <- isJust <$> findExecutable "datumctl"
  datumItems <- if hasDatumctl then useDatumSession >> datumSync else pure Nothing
  st <- yoloState
  names <- sort <$> (listDirectory st `orElse` [])
  dirs <- filterM (doesDirectoryExist . (st </>)) names
  printf "%-20s %-8s %-9s %-16s %s\n" "NAME" "BACKEND" "HARNESS" "CLASS" "STATE" :: IO ()
  backends <- forM dirs $ \n -> do
    b <- readMeta (st </> n </> "backend") "?"
    h <- readMeta (st </> n </> "harness") "?"
    c <- readMeta (st </> n </> "class") "-"
    s <- readMeta (st </> n </> "state") "-"
    printf "%-20s %-8s %-9s %-16s %s\n" n b h c s :: IO ()
    pure b
  forM_ (filter (`notElem` ["?", "datum"]) (nub backends)) $ \b -> do
    putStrLn ""
    putStrLn ("== " ++ b)
    hFlush stdout
    loadBackend root b >>= \be -> bLs be full
  when ("datum" `elem` backends && not hasDatumctl) $
    hPutStrLn stderr "yolo: datumctl isn't in PATH, so the datum sessions can't be checked"
  mapM_ (datumTable full) datumItems

cmdBuild :: FilePath -> [String] -> IO ()
cmdBuild root args0 = do
  backend0 <- opt "BACKEND" "docker"
  let go b c hs = \case
        "--backend" : v : r -> go v c hs r
        "--class" : v : r -> go b (Just v) hs r
        h : r -> go b c (hs ++ [h]) r
        [] -> (b, c, hs)
      (backend, cls, hs0) = go backend0 Nothing [] args0
  mapM_ checkHarness hs0
  when (null hs0) $ die "usage: yolo build HARNESS... [--backend docker|datum] [--class CLASS]"
  case backend of
    "datum" -> buildDatum root (fromMaybe "unikernel" cls) hs0
    "docker" -> do
      when (isJust cls) $ die "--class is for the datum backend"
      d <- containerRuntime >>= dockerConfig
      mapM_ (dockerBuild root d) hs0
    _ -> die ("unknown backend '" ++ backend ++ "'")

----------------------------------------------------------------------------
-- Sessions

-- What a backend implements. A new backend is a new value of this type plus
-- its name in loadBackend.
data Backend = Backend
  { bNew :: String -> String -> [String] -> IO () -- NAME HARNESS options
  , bAttach :: String -> [String] -> IO () -- shell, or run a command
  , bLs :: Bool -> IO () -- full image references?
  , bLogs :: String -> [String] -> IO ()
  , bRm :: String -> IO () -- save workspaces, then delete
  }

loadBackend :: FilePath -> String -> IO Backend
loadBackend root = \case
  "docker" -> dockerBackend root
  "datum" -> datumBackend root
  b -> die ("unknown backend '" ++ b ++ "' (docker or datum)")

harnesses :: [String]
harnesses = ["claude", "gemini", "codex", "opencode", "pi"]

checkHarness :: String -> IO ()
checkHarness h =
  unless (h `elem` harnesses) $ die ("unknown harness '" ++ h ++ "' (have: " ++ unwords harnesses ++ ")")

stateHome :: IO FilePath
stateHome = do
  x <- envNonEmpty "XDG_STATE_HOME"
  home <- getHomeDirectory
  pure (fromMaybe (home </> ".local/state") x)

defaultState :: IO FilePath
defaultState = (</> "yolo/sessions") <$> stateHome

yoloState :: IO FilePath
yoloState = envNonEmpty "YOLO_STATE" >>= maybe defaultState pure

sessionDir :: String -> IO FilePath
sessionDir name = do
  let ok c = isAsciiLower c || isDigit c
      valid =
        length name <= 40 && all (\c -> ok c || c == '-') name
          && maybe False (ok . fst) (uncons name) && maybe False (ok . fst) (uncons (reverse name))
  unless valid $ die "name must be lowercase letters, digits and '-', at most 40 chars"
  (</> name) <$> yoloState

sessionBackend :: String -> IO String
sessionBackend name = do
  dir <- sessionDir name
  e <- doesFileExist (dir </> "backend")
  if e
    then readMeta (dir </> "backend") "?"
    else do
      -- Not made here: maybe a datum session from another machine.
      adopted <- adoptDatum True name
      unless adopted $ die ("no session " ++ name ++ " (yolo ls)")
      pure "datum"

-- Sessions of one backend that have local state.
localSessions :: String -> IO [String]
localSessions backend = do
  st <- yoloState
  names <- sort <$> (listDirectory st `orElse` [])
  filterM (\n -> (== backend) <$> readMeta (st </> n </> "backend") "") names

-- The session's directory, mode 700, with its backend and harness recorded.
sessionCreate :: String -> String -> String -> IO FilePath
sessionCreate name backend harness = do
  dir <- sessionDir name
  e <- doesPathExist dir
  when e $ die ("session " ++ name ++ " exists (" ++ dir ++ "); yolo rm " ++ name ++ " first")
  createDirectoryIfMissing True dir
  setFileMode dir 0o700
  writeFile (dir </> "backend") (backend ++ "\n")
  writeFile (dir </> "harness") (harness ++ "\n")
  pure dir

-- Sessions created by agent-sandbox (Datum only) move here once; the old
-- directory becomes a symlink to the new one. Skipped when YOLO_STATE is
-- overridden.
migrateAgentSandboxState :: IO ()
migrateAgentSandboxState = do
  st <- yoloState
  def <- defaultState
  old <- (</> "agent-sandbox") <$> stateHome
  isDir <- doesDirectoryExist old
  isLink <- pathIsSymbolicLink old `orElse` False
  when (st == def && isDir && not isLink) $ do
    createDirectoryIfMissing True st
    ns <- listDirectory old
    forM_ ns $ \n -> do
      d <- doesDirectoryExist (old </> n)
      when d $ do
        taken <- doesPathExist (st </> n)
        when taken $ die ("can't migrate " ++ n ++ ": " ++ st </> n ++ " exists")
        renameDirectory (old </> n) (st </> n)
        writeFile (st </> n </> "backend") "datum\n"
        hPutStrLn stderr ("yolo: moved agent-sandbox session " ++ n ++ " to " ++ st)
    removeDirectory old
    createDirectoryLink st old

