#!/usr/bin/env bash
# yolo: run coding agents in named, isolated sessions, locally (docker or
# podman) or on Datum Compute. Each session runs one harness's image: claude
# (default), gemini, codex, opencode or pi.
#
#   yolo new NAME [--backend docker|datum] [--agent HARNESS] [backend options]
#                                     create a session and wait until it's ready
#   yolo attach NAME [args...]        shell as drewr, or run a command (alias: ssh)
#   yolo ls                           list sessions
#   yolo logs NAME [args...]          session logs
#   yolo rm NAME                      save workspaces, then delete the session
#   yolo build HARNESS... [--backend docker|datum]
#                                     build images (datum: on the EC2 build box)
#
# The backend defaults to $YOLO_BACKEND, else docker; after `new`, each session
# remembers its own. Backend options: see backends/docker.sh and
# backends/datum.sh. Session state lives in $YOLO_STATE
# (~/.local/state/yolo/sessions).
set -euo pipefail

YOLO_ROOT=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)
# shellcheck source=lib/session.sh
. "$YOLO_ROOT/lib/session.sh"
# shellcheck source=lib/keys.sh
. "$YOLO_ROOT/lib/keys.sh"

# The header comment through the command list (up to the second "#" line).
usage() {
  awk 'NR == 1 { next } /^#/ { sub(/^# ?/, ""); if ($0 == "" && ++blank == 2) exit; print; next } { exit }' \
    "${BASH_SOURCE[0]}"
  exit "${1:-2}"
}

load_backend() {
  case $1 in
    docker|datum) ;;
    *) die "unknown backend '$1' (docker or datum)" ;;
  esac
  # shellcheck source=/dev/null
  . "$YOLO_ROOT/backends/$1.sh"
}

cmd_new() {
  local name=${1:?usage: yolo new NAME [--backend docker|datum] [--agent HARNESS] [options]}; shift
  local backend; backend=$(opt BACKEND docker)
  local harness; harness=$(opt AGENT claude)
  local rest=()
  while [ $# -gt 0 ]; do
    case $1 in
      --backend) backend=$2; shift 2 ;;
      --agent) harness=$2; shift 2 ;;
      *) rest+=("$1"); shift ;;
    esac
  done
  check_harness "$harness"
  session_dir "$name" >/dev/null
  load_backend "$backend"
  backend_new "$name" "$harness" "${rest[@]}"
}

cmd_attach() {
  local name=${1:?usage: yolo attach NAME [args...]}; shift
  load_backend "$(session_backend "$name")"
  backend_attach "$name" "$@"
}

cmd_logs() {
  local name=${1:?usage: yolo logs NAME [args...]}; shift
  load_backend "$(session_backend "$name")"
  backend_logs "$name" "$@"
}

cmd_rm() {
  local name=${1:?usage: yolo rm NAME}
  load_backend "$(session_backend "$name")"
  backend_rm "$name"
}

cmd_ls() {
  local d n b used=''
  printf '%-20s %-8s %s\n' SESSION BACKEND HARNESS
  for d in "$YOLO_STATE"/*/; do
    [ -d "$d" ] || continue
    n=$(basename "$d"); b=$(cat "$d/backend" 2>/dev/null || echo '?')
    printf '%-20s %-8s %s\n' "$n" "$b" "$(cat "$d/harness" 2>/dev/null || echo '?')"
    case " $used " in *" $b "*) ;; *) used+=" $b" ;; esac
  done
  for b in $used; do
    [ "$b" = '?' ] && continue
    echo; echo "== $b"
    ( load_backend "$b"; backend_ls )
  done
}

cmd_build() {
  local backend; backend=$(opt BACKEND docker)
  local harnesses=() h
  while [ $# -gt 0 ]; do
    case $1 in
      --backend) backend=$2; shift 2 ;;
      *) check_harness "$1"; harnesses+=("$1"); shift ;;
    esac
  done
  [ ${#harnesses[@]} -gt 0 ] || die "usage: yolo build HARNESS... [--backend docker|datum]"
  case $backend in
    datum) exec "$YOLO_ROOT/image/build-image" "${harnesses[@]}" ;;
    docker) load_backend docker; for h in "${harnesses[@]}"; do docker_build "$h"; done ;;
    *) die "unknown backend '$backend'" ;;
  esac
}

case ${1:-} in
  help|-h|--help|'') ;;
  *) migrate_agent_sandbox_state ;;
esac

case ${1:-} in
  new|attach|ls|logs|rm|build) c=$1; shift; "cmd_$c" "$@" ;;
  ssh) shift; cmd_attach "$@" ;;
  help|-h|--help) usage 0 ;;
  *) usage ;;
esac
