-- The datum backend: sessions on Datum Compute, reached by SSH over iroh.
--
-- Each session gets a fresh iroh secret and SSH host key generated here,
-- stored in a per-session Datum Secret (agent-NAME) and in the session
-- directory. The client derives the iroh ticket from the secret and pins the
-- host key, so nothing is read from instance logs and there is no
-- trust-on-first-use. Every key in the Secret agent-providers is passed to
-- the session as a variable of the same name (only key names are read here).
-- If the Secret agent-home exists, every session mounts the same JuiceFS
-- volume as HOME. See docs/datum.md.

data Datum = Datum
  { dImages :: FilePath -- unikernel images, one per harness
  , dGpImages :: FilePath -- general-purpose (standard OCI) images
  , dUser :: String -- login user in the sandbox; root also works
  , dForwardAgent :: Bool -- forward the local agent while connected, for git over SSH
  , dPullSecret :: String
  , dLocation :: String
  , dNetwork :: String
  , dInstanceType :: String
  , dClass :: String -- unikernel, or general-purpose
  , dRelay :: String -- the relay instances have chosen in every run so far (n0 use1)
  , dHomeSecret :: String
  , dProvidersSecret :: String
  , dJfsOpts :: String -- extra `juicefs mount` options for the shared home
  }

datumBackend :: FilePath -> IO Backend
datumBackend root = do
  useDatumSession
  d <-
    Datum
      <$> opt "IMAGES" (root </> "image/images")
      <*> opt "GP_IMAGES" (root </> "image/images-general-purpose")
      <*> opt "USER" "drewr"
      <*> ((== "1") <$> opt "FORWARD_AGENT" "1")
      <*> opt "PULL_SECRET" "ghcr-drewr"
      <*> opt "LOCATION" "us-east-1"
      <*> opt "NETWORK" "default"
      <*> opt "INSTANCE_TYPE" "datumcloud/d1-standard-2"
      <*> opt "CLASS" "unikernel"
      <*> opt "RELAY" defaultRelay
      <*> opt "HOME_SECRET" "agent-home"
      <*> opt "PROVIDERS_SECRET" "agent-providers"
      <*> opt "JFS_OPTS" ""
  pure
    Backend
      { bNew = datumNew d
      , bAttach = \name args -> do
          (ssh, sshArgs) <- datumSsh d name args
          executeFile ssh True sshArgs Nothing
      , bLs = \full -> datumSync >>= mapM_ (datumTable full)
      , bLogs = \name args -> rawSystem "datumctl" (["compute", "logs", "agent-" ++ name] ++ args) >>= exitWith
      , bRm = datumRm d
      }

-- The agent workloads on Datum, after making the local state match them:
-- sessions made elsewhere are set up here, and local sessions whose
-- workload is gone are removed (only those of the current Datum login, so
-- another login's sessions survive a switch). Nothing changes when Datum
-- can't be read.
datumSync :: IO (Maybe [A.Value])
datumSync = do
  r <- try (readProcessWithExitCode "datumctl" ["get", "workloads", "-o", "json"] "")
  case r of
    Right (ExitSuccess, out, _) | Just v <- A.decodeStrict (BC.pack out) -> do
      let items = [w | A.Array is <- [at ["items"] v], w <- foldr (:) [] is, "agent-" `isPrefixOf` jstr ["metadata", "name"] w]
          remote = [drop (length "agent-") (jstr ["metadata", "name"] w) | w <- items]
      st <- yoloState
      local <- localSessions "datum"
      forM_ (filter (`notElem` local) remote) $ \n -> do
        taken <- doesPathExist (st </> n)
        if taken
          then hPutStrLn stderr ("yolo: Datum session " ++ n ++ " isn't set up here: a local " ++ n ++ " of another backend has the name")
          else
            try (adoptDatum False n) >>= \case
              Left e -> hPutStrLn stderr ("yolo: couldn't set up " ++ n ++ " from Datum: " ++ show (e :: SomeException))
              Right _ -> pure ()
      current <- fromMaybe "" <$> lookupEnv "DATUM_SESSION"
      forM_ (filter (`notElem` remote) local) $ \n -> do
        owner <- readMeta (st </> n </> "datum_session") current
        when (owner == current) $ do
          removePathForcibly (st </> n)
          hPutStrLn stderr ("yolo: removed " ++ n ++ ": its workload is gone from Datum")
      pure (Just items)
    Right (_, _, err) -> warn (trim err)
    Left e -> warn (show (e :: IOException))
  where
    warn msg = Nothing <$ hPutStrLn stderr ("yolo: can't list Datum sessions, so they weren't synced: " ++ msg)

-- One row per agent workload. Placements and locations stay: sessions may
-- run in other locations. Image references are shortened to
-- repo@digest-prefix unless `full`.
datumTable :: Bool -> [A.Value] -> IO ()
datumTable full items = do
  now <- getCurrentTime
  let num path v = case at path v of A.Number n -> show (round n :: Int); _ -> "0"
      list path v = case at path v of A.Array xs -> foldr (:) [] xs; _ -> []
      row w =
        let placements = list ["spec", "placements"] w
            available = [jstr ["status"] c | c <- list ["status", "conditions"] w, jstr ["type"] c == "Available"]
            img = maybe "" (jstr ["image"]) (listToMaybe (list ["spec", "template", "spec", "runtime", "sandbox", "containers"] w))
         in [ drop (length "agent-") (jstr ["metadata", "name"] w)
            , if available == ["True"] then "Available" else "Unavailable"
            , num ["status", "readyReplicas"] w ++ "/" ++ num ["status", "replicas"] w
            , commas (nub [jstr ["name"] l | p <- placements, l <- list ["locations"] p])
            , commas [jstr ["name"] p | p <- placements]
            , (if full then id else shortImage) img
            , maybe "?" (age now) (iso8601ParseM (jstr ["metadata", "creationTimestamp"] w))
            ]
  unless (null items) $ do
    putStrLn ""
    putStrLn "== datum"
    table (["NAME", "HEALTH", "READY", "LOCATIONS", "PLACEMENTS", "IMAGE", "AGE"] : map row items)
  where
    commas xs = if null xs then "-" else foldr1 (\a b -> a ++ "," ++ b) xs

-- A string at a JSON path ("" when missing).
jstr :: [String] -> A.Value -> String
jstr path v = case at path v of A.String t -> T.unpack t; _ -> ""

-- ghcr.io/drewr/agent-claude@sha256:a415dd44... -> agent-claude@a415dd44231b
shortImage :: String -> String
shortImage ref =
  let (name, digest) = break (== '@') ref
      base = reverse (takeWhile (/= '/') (reverse name))
   in case digest of
        '@' : d -> base ++ "@" ++ take 12 (drop 1 (dropWhile (/= ':') d))
        _ -> base

-- kubectl-style age: 45s, 12m, 3h, 2d.
age :: UTCTime -> UTCTime -> String
age now t =
  let s = floor (diffUTCTime now t) :: Int
   in if s < 120 then show s ++ "s" else if s < 7200 then show (s `div` 60) ++ "m" else if s < 172800 then show (s `div` 3600) ++ "h" else show (s `div` 86400) ++ "d"

-- A JSON value at a path of object keys (Null when missing).
at :: [String] -> A.Value -> A.Value
at [] v = v
at (k : ks) (A.Object o) = maybe A.Null (at ks) (KM.lookup (K.fromString k) o)
at _ _ = A.Null

-- Left-aligned columns, three spaces apart.
table :: [[String]] -> IO ()
table rows =
  let widths = map (maximum . map length) (transpose' rows)
      line r = trimEnd (concat (zipWith (\w c -> c ++ replicate (w - length c + 3) ' ') widths r))
      trimEnd = dropWhileEnd (== ' ')
      transpose' xs = if any null xs || null xs then [] else map head' xs : transpose' (map (drop 1) xs)
      head' = fromMaybe "" . listToMaybe
   in mapM_ (putStrLn . line) rows

-- Datum production (api.datum.net), project drewr-y4nd1b; an explicit
-- session wins.
useDatumSession :: IO ()
useDatumSession = do
  s <- firstEnv ["YOLO_DATUM_SESSION", "AGENT_SANDBOX_DATUM_SESSION", "DATUM_SESSION"]
  setEnv "DATUM_SESSION" (fromMaybe "aaraines@gmail.com@api.datum.net" s)

-- The Datum login a session belongs to, so syncing under another login
-- leaves it alone.
recordDatumSession :: FilePath -> IO ()
recordDatumSession dir = lookupEnv "DATUM_SESSION" >>= mapM_ (writeFile (dir </> "datum_session") . (++ "\n"))

defaultRelay :: String
defaultRelay = "https://use1-1.relay.n0.iroh.link./"

-- Rebuild the local state of a datum session made on another machine, from
-- its Datum Secret (iroh secret, host key, authorized keys) and Workload
-- (harness, class). The host's private key is only used to derive the key
-- to pin; it isn't kept. False if there's no such session on Datum.
adoptDatum :: Bool -> String -> IO Bool
adoptDatum checkKeys name = do
  hasDatumctl <- isJust <$> findExecutable "datumctl"
  if not hasDatumctl
    then pure False
    else do
      useDatumSession
      (wc, wout, _) <- readProcessWithExitCode "datumctl" ["get", "workload", "agent-" ++ name, "-o", "json"] ""
      case (wc, A.decodeStrict (BC.pack wout)) of
        (ExitSuccess, Just w) -> do
          (sc, sout, serr) <- readProcessWithExitCode "datumctl" ["get", "secret", "agent-" ++ name, "-o", "json"] ""
          secret <- case (sc, A.decodeStrict (BC.pack sout)) of
            (ExitSuccess, Just v) -> pure v
            _ -> die ("agent-" ++ name ++ " exists on Datum, but its Secret can't be read: " ++ trim serr)
          let str path v = case at path v of A.String t -> T.unpack t; _ -> ""
              -- Secret data is base64; the *_B64 values are base64 again.
              field k = either (const Nothing) Just (B64.decode (BC.pack (str ["data", k] secret)))
              twice k = field k >>= either (const Nothing) Just . B64.decode
              harness = case str ["metadata", "labels", "agent-harness"] w of "" -> "?"; h -> h
              cls = case str ["spec", "template", "spec", "runtime", "class"] w of "" -> "unikernel"; c -> c
          (irohSecret, hostKey, authorized) <-
            maybe (die ("the Secret agent-" ++ name ++ " is missing session keys")) pure $
              (,,) <$> field "IROH_SECRET" <*> twice "SSH_HOST_KEY_B64" <*> twice "AUTHORIZED_KEYS_B64"
          relay <- opt "RELAY" defaultRelay
          dir <- sessionCreate name "datum" harness
          writeFile (dir </> "class") (cls ++ "\n")
          recordDatumSession dir
          withUmask 0o077 $ do
            let hex = trim (BC.unpack irohSecret)
            writeFile (dir </> "iroh_secret") (hex ++ "\n")
            endpointTicket relay hex >>= writeFile (dir </> "ticket") . (++ "\n")
            B.writeFile (dir </> "authorized_keys") authorized
            let tmp = dir </> "host_key.adopt"
            B.writeFile tmp hostKey
            (kc, pub, _) <- readProcessWithExitCode "ssh-keygen" ["-y", "-f", tmp] ""
            removePathForcibly tmp
            when (kc /= ExitSuccess) $ removePathForcibly dir >> die ("can't read the host key of agent-" ++ name)
            writeFile (dir </> "known_hosts") (unwords (("agent-" ++ name) : take 2 (words pub)) ++ "\n")
          hPutStrLn stderr ("yolo: set up " ++ name ++ " from Datum")
          -- Logging in needs one of this machine's keys among the session's.
          when checkKeys $ do
           r <- timeout 10000000 (try (readProcessWithExitCode "ssh-add" ["-L"] ""))
           let mine = case r of
                 Just (Right (_, out, _)) -> [k | _ : k : _ <- map words (lines out)]
                 Just (Left e) -> const [] (e :: IOException)
                 Nothing -> []
               theirs = [k | _ : k : _ <- map words (lines (BC.unpack authorized))]
           when (not (null mine) && not (any (`elem` theirs) mine)) $
             hPutStrLn stderr ("yolo: none of your agent's keys is authorized for " ++ name ++ "; logging in will fail")
          pure True
        _ -> pure False

datumNew :: Datum -> String -> String -> [String] -> IO ()
datumNew d name harness opts0 = do
  let go k h c = \case
        "--key" : v : r -> go (Just v) h c r
        "--no-home" : r -> go k False c r
        "--class" : v : r -> go k h v r
        o : _ -> Left ("datum: unknown option " ++ o)
        [] -> Right (k, h, c)
  (key, wantHome, cls) <- either die pure (go Nothing True (dClass d) opts0)
  unless (cls `elem` ["unikernel", "general-purpose"]) $
    die ("datum: unknown class '" ++ cls ++ "' (unikernel or general-purpose)")
  forM_ key $ \k -> do
    ok <- (readable <$> getPermissions k) `orElse` False
    unless ok $ die ("datum: cannot read " ++ k)
  homeOk <- (== ExitSuccess) <$> quiet "datumctl" ["get", "secret", dHomeSecret d]
  home <-
    if wantHome && not homeOk
      then hPutStrLn stderr ("yolo: no Secret " ++ dHomeSecret d ++ "; this session's HOME is ephemeral") >> pure False
      else pure wantHome
  let images = if cls == "general-purpose" then dGpImages d else dImages d
  image <-
    opt "IMAGE" "" >>= \case
      "" -> lookupImage images harness
      i -> pure (Just i)
  img <-
    maybe
      (die ("no " ++ cls ++ " image for harness '" ++ harness ++ "' in " ++ images ++ " (yolo build " ++ harness ++ " --backend datum --class " ++ cls ++ ")"))
      pure
      image
  dir <- sessionCreate name "datum" harness
  writeFile (dir </> "class") (cls ++ "\n")
  recordDatumSession dir

  -- Session keys, readable only by this user.
  keys <- withUmask 0o077 $ do
    secret <- B16.encode <$> (getRandomBytes 32 :: IO B.ByteString)
    B.writeFile (dir </> "iroh_secret") (secret <> BC.pack "\n")
    ticket <- endpointTicket (dRelay d) (BC.unpack secret)
    writeFile (dir </> "ticket") (ticket ++ "\n")
    _ <- quiet "ssh-keygen" ["-q", "-t", "ed25519", "-N", "", "-C", "agent-" ++ name, "-f", dir </> "host_key"]
    pub <- words <$> readFile (dir </> "host_key.pub")
    writeFile (dir </> "known_hosts") (unwords (("agent-" ++ name) : take 2 pub) ++ "\n")
    ks <- authorizedKeys key
    forM_ ks (writeFile (dir </> "authorized_keys"))
    -- A --key FILE.pub with its private key beside it is also the identity.
    forM_ key $ \k -> do
      let priv = take (length k - 4) k
      hasPriv <- doesFileExist priv
      when (".pub" `isSuffixOf` k && hasPriv) $
        canonicalizePath priv >>= writeFile (dir </> "identity") . (++ "\n")
    pure ks
  ticketOk <- ("endpoint" `isPrefixOf`) <$> readMeta (dir </> "ticket") ""
  unless ticketOk $ removePathForcibly dir >> die "could not derive the iroh ticket"
  either (\e -> removePathForcibly dir >> die (e ++ "; session not created")) (const (pure ())) keys

  secretHex <- readMeta (dir </> "iroh_secret") ""
  authorized <- B.readFile (dir </> "authorized_keys")
  hostKey <- B.readFile (dir </> "host_key")
  apply "the session Secret" $
    unlines
      [ "apiVersion: v1"
      , "kind: Secret"
      , "metadata:"
      , "  name: agent-" ++ name
      , "type: Opaque"
      , "stringData:"
      , "  IROH_SECRET: \"" ++ secretHex ++ "\""
      , "  AUTHORIZED_KEYS_B64: \"" ++ BC.unpack (B64.encode authorized) ++ "\""
      , "  SSH_HOST_KEY_B64: \"" ++ BC.unpack (B64.encode hostKey) ++ "\""
      ]

  providerKeys <- datumProviderKeyNames d
  pubkey <- pubFromSecretHex secretHex
  let fromSecret s k =
        [ "                - name: " ++ k
        , "                  valueFrom:"
        , "                    secretKeyRef: { name: " ++ s ++ ", key: " ++ k ++ " }"
        ]
      value k v =
        [ "                - name: " ++ k
        , "                  value: " ++ v
        ]
      -- What the shared home's FUSE mount needs outside the unikernel class.
      caps =
        [ "              securityContext:"
        , "                capabilities:"
        , "                  add: [SYS_ADMIN, MKNOD, CHOWN, DAC_OVERRIDE, FOWNER, FSETID, KILL, NET_BIND_SERVICE, SETFCAP, SETGID, SETPCAP, SETUID, SYS_CHROOT]"
        ]
  apply "the Workload" . unlines $
    [ "apiVersion: compute.datumapis.com/v1alpha"
    , "kind: Workload"
    , "metadata:"
    , "  name: agent-" ++ name
    , "  labels:"
    , "    agent-sandbox: \"true\""
    , "    agent-harness: " ++ harness
    , "spec:"
    , "  template:"
    , "    spec:"
    , "      runtime:"
    , "        class: " ++ cls
    , "        resources:"
    , "          instanceType: " ++ dInstanceType d
    , "        sandbox:"
    , "          imagePullSecrets:"
    , "            - name: " ++ dPullSecret d
    , "          containers:"
    , "            - name: agent"
    , "              image: " ++ img
    ]
      ++ (if cls == "general-purpose" then caps else [])
      ++ ["              env:"]
      ++ value "YOLO_MODE" "datum"
      ++ value "SESSION_NAME" name
      ++ value "JFS_MOUNT_OPTS" (show (dJfsOpts d))
      ++ value "ENDPOINT_DNS" ("_iroh." ++ zbase32 pubkey ++ ".dns.iroh.link")
      ++ concatMap (fromSecret ("agent-" ++ name)) ["IROH_SECRET", "AUTHORIZED_KEYS_B64", "SSH_HOST_KEY_B64"]
      -- One secretKeyRef per provider key (the unikernel class has no envFrom).
      ++ value "PROVIDER_KEYS" (show (unwords providerKeys))
      ++ concatMap (fromSecret (dProvidersSecret d)) providerKeys
      ++ (if home then concatMap (fromSecret (dHomeSecret d)) ["META_TICKET", "META_URL", "AWS_ACCESS_KEY_ID", "AWS_SECRET_ACCESS_KEY"] else [])
      ++ [ "      networkInterfaces:"
         , "        - network:"
         , "            name: " ++ dNetwork d
         , "  placements:"
         , "    - name: default"
         , "      locations:"
         , "        - name: " ++ dLocation d
         , "      scaleSettings:"
         , "        minReplicas: 1"
         ]
  hPutStrLn stderr ("created agent-" ++ name ++ " (" ++ harness ++ ": " ++ img ++ "); waiting for SSH...")
  t0 <- getCurrentTime
  let wait = do
        (ssh, args) <- datumSsh d name ["-o", "ConnectTimeout=20", "-o", "BatchMode=yes", "true"]
        ok <- (== ExitSuccess) <$> quiet ssh args
        n <- secondsSince t0
        unless ok $ do
          when (n >= 300) $ die ("no SSH after 5 min; try: yolo logs " ++ name)
          threadDelay 10000000 >> wait
  wait
  n <- secondsSince t0
  hPutStrLn stderr ("ready after " ++ show n ++ "s: yolo attach " ++ name)

-- ssh and its arguments for the session. Options go before the destination;
-- anything after "--", or from the first non-option on, is the command.
datumSsh :: Datum -> String -> [String] -> IO (FilePath, [String])
datumSsh d name args = do
  dir <- sessionDir name
  hasTicket <- doesFileExist (dir </> "ticket")
  unless hasTicket $ die ("no local state for " ++ name)
  ticket <- readMeta (dir </> "ticket") ""
  identity <- readFileMaybe (dir </> "identity")
  let split acc = \case
        "--" : r -> (acc, r)
        o : v : r | o `elem` ["-o", "-L", "-R", "-D", "-i"] -> split (acc ++ [o, v]) r
        o : r | "-" `isPrefixOf` o -> split (acc ++ [o]) r
        r -> (acc, r)
      (opts, cmd) = split [] args
      idOpts = maybe [] (\i -> ["-i", trim i, "-o", "IdentitiesOnly=yes"]) identity
      fwd = if dForwardAgent d then ["-o", "ForwardAgent=yes"] else []
  pure
    ( "ssh"
    , [ "-o", "ProxyCommand=dumbpipe connect " ++ ticket ++ " 2>/dev/null"
      , "-o", "UserKnownHostsFile=" ++ dir </> "known_hosts"
      , "-o", "HostKeyAlias=agent-" ++ name
      , "-o", "StrictHostKeyChecking=yes"
      , "-o", "ServerAliveInterval=30"
      ]
        ++ idOpts ++ fwd ++ opts ++ [dUser d ++ "@agent-" ++ name] ++ cmd
    )

datumRm :: Datum -> String -> IO ()
datumRm d name = do
  dir <- sessionDir name
  -- Persist RAM workspaces (/work) to the shared home and release their locks
  -- before the instance goes, so another session can open them right away.
  hasTicket <- doesFileExist (dir </> "ticket")
  when hasTicket $ do
    (ssh, args) <- datumSsh d name ["-o", "BatchMode=yes", "-o", "ConnectTimeout=20", "--", "HOME=/home/agent; [ -d /work ] && ws close --all"]
    quiet ssh args >>= \case
      ExitSuccess -> hPutStrLn stderr "workspaces saved"
      _ -> hPutStrLn stderr ("yolo: could not save workspaces of " ++ name)
  forM_ ["workload", "secret"] $ \kind -> do
    -- The outcome: stdout's last line ("... deleted"), else the error.
    (_, out, err) <- readProcessWithExitCode "datumctl" ["delete", kind, "agent-" ++ name] ""
    mapM_ putStrLn (lastLine out <|> lastLine err)
  removePathForcibly dir

-- Key names in the providers Secret that are valid variable names. Values
-- are never read here.
datumProviderKeyNames :: Datum -> IO [String]
datumProviderKeyNames d = do
  (code, out, _) <- readProcessWithExitCode "datumctl" ["get", "secret", dProvidersSecret d, "-o", "json"] ""
  let keys = case A.decodeStrict (BC.pack out) of
        Just (A.Object o) | code == ExitSuccess, Just (A.Object dat) <- KM.lookup (K.fromString "data") o -> map K.toString (KM.keys dat)
        _ -> []
  pure (filter isVarName keys)

apply :: String -> String -> IO ()
apply what yaml = do
  (code, _, err) <- readProcessWithExitCode "datumctl" ["apply", "-f", "-"] yaml
  unless (code == ExitSuccess) $ die ("could not apply " ++ what ++ ": " ++ trim err)

lookupImage :: FilePath -> String -> IO (Maybe String)
lookupImage file harness = do
  ls <- maybe [] lines <$> readFileMaybe file
  pure (listToMaybe [i | h : i : _ <- map words ls, h == harness])

----------------------------------------------------------------------------
-- Keys and iroh tickets

-- The iroh endpoint public key for a hex ed25519 secret.
pubFromSecretHex :: String -> IO B.ByteString
pubFromSecretHex hex = do
  raw <- either (const (die "bad iroh secret")) pure (B16.decode (BC.pack (trim hex)))
  sk <- throwCryptoErrorIO (Ed.secretKey raw)
  pure (BA.convert (Ed.toPublic sk))

-- 5-bit groups over the bytes, zero-padded at the end (base32 without '=').
encode5 :: String -> B.ByteString -> String
encode5 alphabet bytes = map (\g -> alphabet !! foldl (\a b -> a * 2 + fromEnum b) 0 g) (groups padded)
  where
    bits = concatMap (\w -> [testBit w i | i <- [7, 6 .. 0]]) (B.unpack bytes)
    padded = bits ++ replicate ((5 - length bits `mod` 5) `mod` 5) False
    groups [] = []
    groups xs = take 5 xs : groups (drop 5 xs)

-- z-base-32 label for iroh's DNS discovery name _iroh.<label>.dns.iroh.link.
zbase32 :: B.ByteString -> String
zbase32 = encode5 "ybndrfg8ejkmcpqxot1uwisza345h769"

-- An iroh endpoint ticket that carries the relay URL, so the client dials the
-- relay directly instead of depending on DNS discovery, which instances have
-- failed to publish to (docs/datum.md). Wire format, as decoded from dumbpipe
-- tickets: 00 | pubkey(32) | n_addrs | 00 len url.
endpointTicket :: String -> String -> IO String
endpointTicket relay secretHex = do
  when (length relay >= 128) $ die "relay URL too long"
  pub <- pubFromSecretHex secretHex
  let url = BC.pack relay
      bytes = B.concat [B.singleton 0, pub, B.pack [1, 0, fromIntegral (B.length url)], url]
  pure ("endpoint" ++ encode5 "abcdefghijklmnopqrstuvwxyz234567" bytes)

-- Public keys to authorize: FILE if given, else the SSH agent's, else
-- ~/.ssh/id_*.pub. Never empty: a session nobody can log in to is useless.
-- The agent query has a timeout because forwarded agents can stall.
authorizedKeys :: Maybe FilePath -> IO (Either String String)
authorizedKeys mfile = do
  keys <- case mfile of
    Just f -> fromMaybe "" <$> readFileMaybe f
    Nothing -> do
      r <- timeout 10000000 (try (readProcessWithExitCode "ssh-add" ["-L"] ""))
      let agentKeys = case r of
            Just (Right (_, out, _)) -> unlines (filter ("ssh-" `isPrefixOf`) (lines out))
            Just (Left e) -> const "" (e :: IOException)
            Nothing -> ""
      if not (null agentKeys)
        then pure agentKeys
        else do
          home <- getHomeDirectory
          found <- filterM doesFileExist [home </> ".ssh" </> f | f <- ["id_ed25519.pub", "id_ecdsa.pub", "id_rsa.pub"]]
          maybe (pure "") readFile (listToMaybe found)
  pure $
    if any ("ssh-" `isPrefixOf`) (lines keys)
      then Right (unlines (lines keys))
      else Left "no public key to authorize: load one into ssh-agent (is it responding?) or pass --key FILE"

----------------------------------------------------------------------------
-- The docker backend: long-lived local containers (podman, colima or docker) running
-- the same per-harness image as Datum, in local mode.
--
-- - Container yolo-NAME, image yolo/HARNESS:local (built on first use, or
--   with `yolo build HARNESS`).
-- - HOME is $YOLO_DOCKER_HOME (~/.local/share/yolo/home), shared by every
--   docker session and kept across `yolo rm`. The login user takes your uid.
-- - Provider keys: $YOLO_PROVIDERS_ENV (~/.config/yolo/providers.env;
--   KEY=value lines, keep it 0600), if it exists.
-- - Git: GIT_NAME, GIT_EMAIL, GIT_SIGNING_KEY and GITHUB_TOKEN are passed in.
-- - SSH agent: while you're attached, a socat relay in the session directory
--   connects the container to your current $SSH_AUTH_SOCK
--   (YOLO_FORWARD_AGENT=0 turns it off). Podman and colima on macOS can't
--   share sockets with the VM (VirtioFS), so there, or whenever SSH_PRIVATE_KEY_FILE (a key
--   path) or SSH_PRIVATE_KEY (base64 key) is set, the key is mounted
--   read-only instead and loaded into an agent inside the session. It must
--   have no passphrase.
-- - ~/.ssh/allowed_signers, if present, is copied in for git signature checks.

data Docker = Docker
  { rt :: String -- podman (maybe a store path) or docker
  , dkVM :: Bool -- runs in a VM that can't share host sockets
  , dkHome :: FilePath
  , dkProvidersEnv :: FilePath
  , dkForwardAgent :: Bool
  , dkUser :: String
  }

-- A container runtime: the executable (a store path, when it came from nix),
-- whether it runs in a VM that can't share host sockets, and the docker
-- context it needs, if any. A session keeps the one it was made with in its
-- `runtime` file, so later commands don't depend on what PATH has.
data Runtime = Runtime
  { rtExe :: String
  , rtVM :: Bool
  , rtContext :: Maybe String
  }
  deriving (Eq)

-- $YOLO_RUNTIME (or $CONTAINER_RUNTIME), else the first of podman and colima
-- (each from PATH, or else nixpkgs; colima through the docker CLI and its
-- docker context) and docker that is up.
containerRuntimeMaybe :: IO (Maybe Runtime)
containerRuntimeMaybe = do
  explicit <- firstEnv ["YOLO_RUNTIME", "CONTAINER_RUNTIME"]
  case explicit of
    Just r -> pure (Just (Runtime r (os == "darwin" && takeFileName r == "podman") Nothing))
    Nothing -> firstJustM [podmanRuntime, colimaRuntime, dockerRuntime]

containerRuntime :: IO Runtime
containerRuntime = containerRuntimeMaybe >>= maybe (die "docker: no podman, colima or docker found (podman and colima must be running)") pure

writeRuntime :: FilePath -> Runtime -> IO ()
writeRuntime dir r = writeFile (dir </> "runtime") (unlines [rtExe r, if rtVM r then "vm" else "-", fromMaybe "-" (rtContext r)])

readRuntime :: FilePath -> IO (Maybe Runtime)
readRuntime dir = do
  c <- readFileMaybe (dir </> "runtime")
  pure $ case fmap lines c of
    Just [e, vm, ctx] | not (null e) -> Just (Runtime e (vm == "vm") (if ctx == "-" then Nothing else Just ctx))
    _ -> Nothing

firstJustM :: [IO (Maybe a)] -> IO (Maybe a)
firstJustM = \case
  [] -> pure Nothing
  a : as -> a >>= maybe (firstJustM as) (pure . Just)

-- EXE from PATH, else from nixpkgs#PKG when nix is there to build it.
findOrNix :: String -> String -> IO (Maybe FilePath)
findOrNix pkg exe = do
  onPath <- findExecutable exe
  maybe (nixBin pkg exe) (const (pure (Just exe))) onPath

nixBin :: String -> String -> IO (Maybe FilePath)
nixBin pkg exe = do
  hasNix <- findExecutable "nix"
  case hasNix of
    Nothing -> pure Nothing
    Just _ -> do
      hPutStrLn stderr ("yolo: no " ++ exe ++ " in PATH; trying nixpkgs#" ++ pkg)
      r <- try (readProcessWithExitCode "nix" ["--extra-experimental-features", "nix-command flakes", "build", "--no-link", "--print-out-paths", "nixpkgs#" ++ pkg] "")
      case r of
        Right (ExitSuccess, out, _) -> listToMaybe <$> filterM doesFileExist [o </> "bin" </> exe | o <- lines out]
        Right _ -> pure Nothing
        Left e -> const (pure Nothing) (e :: IOException)

podmanRuntime :: IO (Maybe Runtime)
podmanRuntime = do
  podman <- findOrNix "podman" "podman"
  case podman of
    Nothing -> pure Nothing
    Just p -> do
      up <- quiet p ["info"]
      pure (if up == ExitSuccess then Just (Runtime p (os == "darwin") Nothing) else Nothing)

-- Colima runs the docker daemon in a VM; the docker CLI reaches it through
-- its docker context.
colimaRuntime :: IO (Maybe Runtime)
colimaRuntime = do
  colima <- findOrNix "colima" "colima"
  case colima of
    Nothing -> pure Nothing
    Just c -> do
      up <- quiet c ["status"]
      if up /= ExitSuccess
        then pure Nothing
        else do
          docker <- findOrNix "docker-client" "docker"
          pure (fmap (\d -> Runtime d (os == "darwin") (Just "colima")) docker)

dockerRuntime :: IO (Maybe Runtime)
dockerRuntime = fmap (const (Runtime "docker" False Nothing)) <$> findExecutable "docker"

-- Settings around a runtime, which also takes effect: its docker context.
dockerConfig :: Runtime -> IO Docker
dockerConfig r = do
  mapM_ (setEnv "DOCKER_CONTEXT") (rtContext r)
  home <- getHomeDirectory
  dataHome <- fromMaybe (home </> ".local/share") <$> envNonEmpty "XDG_DATA_HOME"
  configHome <- fromMaybe (home </> ".config") <$> envNonEmpty "XDG_CONFIG_HOME"
  let homeDefault
        | os == "darwin" = home </> "Library/Application Support/yolo/home"
        | otherwise = dataHome </> "yolo/home"
  Docker (rtExe r) (rtVM r)
    <$> opt "DOCKER_HOME" homeDefault
    <*> opt "PROVIDERS_ENV" (configHome </> "yolo/providers.env")
    <*> ((== "1") <$> opt "FORWARD_AGENT" "1")
    <*> opt "USER" "drewr"

dockerImage :: String -> String
dockerImage h = "yolo/" ++ h ++ ":local"

-- Podman machine and colima on macOS share host files over VirtioFS, which
-- can't carry Unix sockets, so the agent relay can't reach the container.
noSocketRelay :: Docker -> Bool
noSocketRelay = dkVM

-- yolo/HARNESS:local from image/, with the same Dockerfile Datum uses.
dockerBuild :: FilePath -> Docker -> String -> IO ()
dockerBuild root d h = do
  hPutStrLn stderr ("yolo: building " ++ dockerImage h)
  code <- rawSystem (rt d) ["build", "--build-arg", "HARNESS=" ++ h, "-t", dockerImage h, "-f", root </> "image/Dockerfile", root </> "image"]
  unless (code == ExitSuccess) $ die ("docker: could not build " ++ dockerImage h)

-- The runtime a session was made with; failing that (older sessions), the
-- one found now.
sessionDocker :: String -> IO Docker
sessionDocker name = do
  dir <- sessionDir name
  readRuntime dir >>= maybe containerRuntime pure >>= dockerConfig

dockerBackend :: FilePath -> IO Backend
dockerBackend root =
  pure
    Backend
      { bNew = \name harness opts -> do
          r <- containerRuntime
          d <- dockerConfig r
          dockerNew root r d name harness opts
      , bAttach = \name args -> sessionDocker name >>= \d -> dockerAttach d name args
      , bLs = \_ -> dockerLs
      , bLogs = \name args -> sessionDocker name >>= \d -> rawSystem (rt d) (["logs"] ++ args ++ ["yolo-" ++ name]) >>= exitWith
      , bRm = \name -> do
          d <- sessionDocker name
          dir <- sessionDir name
          -- Workspaces are bind mounts and HOME is on the host: nothing to save.
          code <- quiet (rt d) ["rm", "-f", "yolo-" ++ name]
          when (code == ExitSuccess) $ hPutStrLn stderr ("removed yolo-" ++ name)
          removePathForcibly dir
      }

-- The containers of every docker session, once per runtime the sessions use.
dockerLs :: IO ()
dockerLs = do
  st <- yoloState
  names <- sort <$> (listDirectory st `orElse` [])
  mine <- filterM (\n -> (== "docker") <$> readMeta (st </> n </> "backend") "?") names
  recorded <- forM mine $ \n -> readRuntime (st </> n)
  -- Sessions from before runtimes were recorded use the one found now.
  found <- if any (== Nothing) recorded then containerRuntimeMaybe else pure Nothing
  let used = nub (mapMaybe (<|> found) recorded)
  when (null used) $ hPutStrLn stderr "yolo: no container runtime found to list the docker sessions"
  forM_ used $ \r -> do
    putStrLn ("runtime: " ++ rtExe r)
    d <- dockerConfig r
    () <$ rawSystem (rt d) ["ps", "-a", "--filter", "name=^yolo-", "--format", "table {{.Names}}\t{{.Status}}\t{{.Image}}"]

dockerNew :: FilePath -> Runtime -> Docker -> String -> String -> [String] -> IO ()
dockerNew root r d name harness opts0 = do
  let parse acc = \case
        v : m : r | v `elem` ["-v", "--volume"] -> do
          let host = takeWhile (/= ':') m
          e <- doesPathExist host
          unless e $ die ("docker: " ++ host ++ " does not exist")
          real <- canonicalizePath host
          parse (acc ++ ["-v", real ++ dropWhile (/= ':') m]) r
        o : _ -> die ("docker: unknown option " ++ o)
        [] -> pure acc
  mounts <- parse [] opts0
  let image = dockerImage harness
  -- The session exists from here on, so `yolo ls` shows it while the image
  -- builds; `state` says what it's doing, until it's ready.
  dir <- sessionCreate name "docker" harness
  writeRuntime dir r
  hPutStrLn stderr ("yolo: runtime " ++ rtExe r)
  present <- (== ExitSuccess) <$> quiet (rt d) ["image", "inspect", image]
  unless present $ do
    writeFile (dir </> "state") "building\n"
    dockerBuild root d harness `onException` removePathForcibly dir
  writeFile (dir </> "state") "starting\n"
  createDirectoryIfMissing True (dkHome d)
  createDirectoryIfMissing True (dir </> "agent")
  let failNew :: String -> IO a
      failNew msg = removePathForcibly dir >> die msg

  -- SSH: relay the host agent at attach, or inject a key (see above).
  keyB64 <- envNonEmpty "SSH_PRIVATE_KEY"
  keyFile <- envNonEmpty "SSH_PRIVATE_KEY_FILE"
  keyMount <- case (keyB64, keyFile) of
    (Just b64, _) -> case B64.decode (BC.filter (not . isSpace) (BC.pack b64)) of
      Left _ -> failNew "docker: SSH_PRIVATE_KEY is not valid base64"
      Right key -> do
        withUmask 0o077 (B.writeFile (dir </> "ssh_key") key)
        pure ["-v", dir </> "ssh_key" ++ ":/run/yolo-key/id:ro"]
    (_, Just f) -> do
      ok <- (readable <$> getPermissions f) `orElse` False
      unless ok $ failNew ("docker: cannot read " ++ f)
      real <- canonicalizePath f
      pure ["-v", real ++ ":/run/yolo-key/id:ro"]
    _ -> do
      when (noSocketRelay d) $
        hPutStrLn stderr ("yolo: " ++ takeFileName (rt d) ++ " (a VM on macOS) can't relay the SSH agent; set SSH_PRIVATE_KEY_FILE for SSH in the session")
      pure []
  unless (null keyMount) $ writeFile (dir </> "ssh_key_mode") ""
  -- Copied rather than bind-mounted: it is often a symlink into /nix/store,
  -- which a podman machine VM can't see.
  home <- getHomeDirectory
  hasSigners <- doesFileExist (home </> ".ssh/allowed_signers")
  signers <-
    if hasSigners
      then do
        copyFile (home </> ".ssh/allowed_signers") (dir </> "allowed_signers")
        pure ["-v", dir </> "allowed_signers" ++ ":/etc/ssh/allowed_signers:ro"]
      else pure []

  uid <- getRealUserID
  gid <- getRealGroupID
  git <- filterM (fmap isJust . envNonEmpty) ["GIT_NAME", "GIT_EMAIL", "GIT_SIGNING_KEY", "GITHUB_TOKEN"]
  hasProviders <- doesFileExist (dkProvidersEnv d)
  providers <-
    if hasProviders
      then do
        names <- mapMaybe providerName . lines <$> readFile (dkProvidersEnv d)
        pure ["--env-file", dkProvidersEnv d, "-e", "PROVIDER_KEYS=" ++ unwords names]
      else pure []
  let env =
        ["-e", "YOLO_MODE=local", "-e", "SESSION_NAME=" ++ name, "-e", "HOST_UID=" ++ show uid, "-e", "HOST_GID=" ++ show gid]
          ++ concatMap (\v -> ["-e", v]) git
          ++ providers
  code <-
    quiet (rt d) $
      ["run", "-d", "--name", "yolo-" ++ name, "--hostname", name]
        ++ env
        ++ ["-v", dkHome d ++ ":/home/agent", "-v", dir </> "agent" ++ ":/run/yolo-agent"]
        ++ keyMount ++ signers ++ mounts ++ [image]
  unless (code == ExitSuccess) $ failNew ("docker: could not start yolo-" ++ name)
  hPutStrLn stderr ("started yolo-" ++ name ++ " (" ++ harness ++ ": " ++ image ++ "); waiting for init...")
  t0 <- getCurrentTime
  let wait = do
        (_, out, err) <- readProcessWithExitCode (rt d) ["logs", "yolo-" ++ name] ""
        unless ("[agent] ready" `isInfixOf` (out ++ err)) $ do
          n <- secondsSince t0
          when (n >= 120) $ writeFile (dir </> "state") "not ready\n" >> die ("init not ready after 2 min; try: yolo logs " ++ name)
          threadDelay 1000000 >> wait
  wait
  removePathForcibly (dir </> "state")
  n <- secondsSince t0
  hPutStrLn stderr ("ready after " ++ show n ++ "s: yolo attach " ++ name)
  where
    providerName l = case break (== '=') l of
      (k, '=' : _) | isVarName k -> Just k
      _ -> Nothing

dockerAttach :: Docker -> String -> [String] -> IO ()
dockerAttach d name args = do
  dir <- sessionDir name
  tty <- (&&) <$> hIsTerminalDevice stdin <*> hIsTerminalDevice stdout
  keyMode <- doesFileExist (dir </> "ssh_key_mode")
  hostSock <- envNonEmpty "SSH_AUTH_SOCK"
  sockOk <- maybe (pure False) (\s -> (isSocket <$> getFileStatus s) `orElse` False) hostSock
  term <- fromMaybe "xterm-256color" <$> envNonEmpty "TERM"
  let sock = dir </> "agent/agent.sock"
  -- The session's own agent holding an injected key, or else the current SSH
  -- agent, relayed only while attached.
  (relay, agentEnv) <-
    if keyMode
      then pure (Nothing, ["-e", "SSH_AUTH_SOCK=/run/yolo-ssh/agent.sock"])
      else case hostSock of
        Just hs | dkForwardAgent d && sockOk && not (noSocketRelay d) -> do
          removePathForcibly sock
          devnull <- openFile "/dev/null" WriteMode
          (_, _, _, p) <-
            createProcess
              (proc "socat" ["UNIX-LISTEN:" ++ sock ++ ",fork,mode=600", "UNIX-CONNECT:" ++ hs])
                { std_out = UseHandle devnull, std_err = UseHandle devnull }
          let waitSock n = do
                up <- fileExist sock
                unless (up || n == (0 :: Int)) $ threadDelay 100000 >> waitSock (n - 1)
          waitSock 50
          pure (Just p, ["-e", "SSH_AUTH_SOCK=/run/yolo-agent/agent.sock"])
        _ -> pure (Nothing, [])
  let zsh = if null args then ["zsh", "-l"] else ["zsh", "-lc", unwords args]
  code <-
    rawSystem
      (rt d)
      ( ["exec", if tty then "-it" else "-i", "-u", dkUser d, "-w", "/home/agent", "-e", "SHELL=/bin/zsh", "-e", "TERM=" ++ term]
          ++ agentEnv ++ ["yolo-" ++ name] ++ zsh
      )
      `finally` (mapM_ terminateProcess relay >> removePathForcibly sock)
  exitWith code

