-- Image builds (datum): on the EC2 build box, over iroh.
--
-- unikernel (default): `datumctl compute build` against the box's BuildKit,
-- pinned in image/images. general-purpose: a standard linux/amd64 image via
-- buildctl, pinned in image/images-general-purpose and pushed with your
-- registry login (~/.docker/config.json). Pins llm-agents and nixpkgs to the
-- dotfiles' revisions first (sync-pins). The box must be running; its ticket
-- comes from $BUILDBOX_TICKET or ~/.local/state/agent-sandbox-build
-- (yolo infra buildbox ticket). If BuildKit doesn't answer, the box is
-- started (it stops itself after 30 idle minutes) and waited for.

buildDatum :: FilePath -> String -> [String] -> IO ()
buildDatum root cls hs = do
  needCheckout root "yolo build --backend datum"
  (images, tag) <- case cls of
    "unikernel" -> pure (root </> "image/images", "dev")
    "general-purpose" -> pure (root </> "image/images-general-purpose", "gp-dev")
    _ -> die ("unknown class '" ++ cls ++ "' (unikernel or general-purpose)")
  state <- (</> "agent-sandbox-build") <$> stateHome
  registry <- fromMaybe "ghcr.io/drewr" <$> envNonEmpty "AGENT_IMAGE_REGISTRY"
  box <- boxConfig "buildbox"
  port <- fromMaybe "12340" <$> envNonEmpty "BUILDBOX_PORT"
  createDirectoryIfMissing True (state </> "logs")
  syncPins root
  let ctx = root </> "image"
      buildkit = "tcp://127.0.0.1:" ++ port
  failures <- newIORef (0 :: Int)
  withBuildkit box port $ forM_ hs (\h -> do
    let logFile = state </> "logs" </> ("build-" ++ h ++ "-" ++ cls ++ ".log")
        meta = state </> "logs" </> ("build-" ++ h ++ "-" ++ cls ++ ".json")
        image = registry ++ "/agent-" ++ h ++ ":" ++ tag
        repo = registry ++ "/agent-" ++ h
    t0 <- getCurrentTime
    removePathForcibly meta
    code <- withFile logFile WriteMode $ \lh ->
      if cls == "general-purpose"
        then
          runLogged lh "buildctl" $
            [ "--addr", buildkit, "build", "--progress", "plain"
            , "--frontend", "dockerfile.v0", "--local", "context=" ++ ctx, "--local", "dockerfile=" ++ ctx
            , "--opt", "platform=linux/amd64", "--opt", "build-arg:HARNESS=" ++ h
            , "--output", "type=image,name=" ++ image ++ ",push=true", "--metadata-file", meta
            ]
        else runLogged lh "datumctl" ["compute", "build", "--analyze", "--push", "--buildkit-host", buildkit, "-o", image, "--build-arg", "HARNESS=" ++ h, ctx]
    out <- fromMaybe "" <$> readFileMaybe logFile
    ref <-
      if code /= ExitSuccess
        then pure Nothing
        else
          if cls == "general-purpose"
            then do
              m <- readFileMaybe meta
              pure $ case m >>= A.decodeStrict . BC.pack of
                Just (A.Object o) | Just (A.String dg) <- KM.lookup (K.fromString "containerimage.digest") o -> Just (repo ++ "@" ++ T.unpack dg)
                _ -> Nothing
            else pure (lastDigestRef repo out)
    n <- secondsSince t0
    case ref of
      Just r -> do
        pinImage images cls h r
        (printf "%s: %s (%ds)\n" h r n :: IO ()) >> hFlush stdout
      Nothing -> do
        let errLine = take 200 (fromMaybe "" (lastLine (unlines (filter (("error" `isInfixOf`) . map toLower) (lines out)))))
        hPrintf stderr "%s: FAILED after %ds: %s (log: %s)\n" h n errLine logFile :: IO ()
        modifyIORef failures (+ 1))
  bad <- readIORef failures
  when (bad > 0) exitFailure

-- A local port forwarded to the build box's BuildKit while `act` runs.
withTunnel :: String -> String -> IO a -> IO a
withTunnel ticket port act = do
  devnull <- openFile "/dev/null" WriteMode
  bracket
    ( do
        (_, _, _, p) <-
          createProcess
            (proc "dumbpipe" ["connect-tcp", "--addr", "127.0.0.1:" ++ port, ticket])
              { std_out = UseHandle devnull, std_err = UseHandle devnull }
        pure p
    )
    terminateProcess
    ( \_ -> do
        let up n = do
              ok <- canConnect port
              unless (ok || n == (0 :: Int)) $ threadDelay 1000000 >> up (n - 1)
        up 30
        act
    )

canConnect :: String -> IO Bool
canConnect port = do
  r <- try $ do
    addrs <- N.getAddrInfo (Just N.defaultHints {N.addrSocketType = N.Stream}) (Just "127.0.0.1") (Just port)
    case addrs of
      addr : _ -> bracket (N.openSocket addr) N.close (\s -> N.connect s (N.addrAddress addr))
      [] -> fail "no address"
  pure (either (\e -> const False (e :: SomeException)) (const True) r)

runLogged :: Handle -> FilePath -> [String] -> IO ExitCode
runLogged lh cmd args = do
  (_, _, _, p) <- createProcess (proc cmd args) {std_out = UseHandle lh, std_err = UseHandle lh}
  waitForProcess p

-- The last REPO@sha256:... in a build log.
lastDigestRef :: String -> String -> Maybe String
lastDigestRef repo out = if null refs then Nothing else Just (last refs)
  where
    pre = repo ++ "@sha256:"
    refs = go out
    go s
      | null s = []
      | pre `isPrefixOf` s = (pre ++ takeWhile isHexDigit (drop (length pre) s)) : go (drop (length pre) s)
      | otherwise = go (drop 1 s)

-- Replace HARNESS's line in an images file (created with a header).
pinImage :: FilePath -> String -> String -> String -> IO ()
pinImage file cls h ref = do
  old <- readFileMaybe file
  let header = "# One pinned image per harness for the " ++ cls ++ " class (yolo build HARNESS --backend datum --class " ++ cls ++ ")."
      kept = filter (\l -> listToMaybe (words l) /= Just h) (maybe [header] lines old)
  writeFile file (unlines (kept ++ [h ++ replicate (9 - length h) ' ' ++ " " ++ ref]))

-- Pin image/flake.lock's llm-agents and nixpkgs to the revisions the dotfiles
-- use (d/.config/home-manager/flake.lock in the locked `dotfiles` input), so
-- the images carry the same harness versions and nixpkgs as a laptop with
-- these dotfiles. To follow newer dotfiles: nix flake update dotfiles
-- --flake image, then build.
syncPins :: FilePath -> IO ()
syncPins root = do
  needCheckout root "yolo sync-pins"
  let here = root </> "image"
      nix = ["--extra-experimental-features", "nix-command flakes"]
  (code, dotfiles, err) <- readProcessWithExitCode "nix" (nix ++ ["eval", "--raw", here ++ "#lib.dotfiles"]) ""
  unless (code == ExitSuccess) $ die ("sync-pins: " ++ trim err)
  dot <- B.readFile (dotfiles </> "d/.config/home-manager/flake.lock")
  lock <- B.readFile (here </> "flake.lock")
  let rev l i = fromMaybe "?" (lockedRev l i)
      (wantA, wantN) = (rev dot "llm-agents", rev dot "nixpkgs")
      (haveA, haveN) = (rev lock "llm-agents", rev lock "nixpkgs")
      short = take 7
  if wantA == haveA && wantN == haveN
    then printf "sync-pins: already at the dotfiles' pins (llm-agents %s, nixpkgs %s)\n" (short wantA) (short wantN) :: IO ()
    else do
      (c, o, e) <-
        readProcessWithExitCode
          "nix"
          (nix ++ ["flake", "lock", here, "--override-input", "llm-agents", "github:numtide/llm-agents.nix/" ++ wantA, "--override-input", "nixpkgs", "github:nixos/nixpkgs/" ++ wantN])
          ""
      putStr (unlines (filter (not . ("warning: Git tree" `isPrefixOf`)) (lines (o ++ e))))
      unless (c == ExitSuccess) $ die "sync-pins: nix flake lock failed"
      printf "sync-pins: llm-agents %s -> %s, nixpkgs %s -> %s\n" (short haveA) (short wantA) (short haveN) (short wantN) :: IO ()
  hFlush stdout

-- The locked rev of a root input in a flake.lock.
lockedRev :: B.ByteString -> String -> Maybe String
lockedRev lockFile input = do
  A.Object top <- A.decodeStrict lockFile
  A.Object nodes <- KM.lookup (K.fromString "nodes") top
  A.String rootName <- KM.lookup (K.fromString "root") top
  A.Object rootNode <- KM.lookup (K.fromText rootName) nodes
  A.Object inputs <- KM.lookup (K.fromString "inputs") rootNode
  A.String node <- KM.lookup (K.fromString input) inputs
  A.Object n <- KM.lookup (K.fromText node) nodes
  A.Object locked <- KM.lookup (K.fromString "locked") n
  A.String r <- KM.lookup (K.fromString "rev") locked
  pure (T.unpack r)

----------------------------------------------------------------------------
-- Helpers

die :: String -> IO a
die msg = hPutStrLn stderr ("yolo: " ++ msg) >> exitFailure

envNonEmpty :: String -> IO (Maybe String)
envNonEmpty k = (\v -> if v == Just "" then Nothing else v) <$> lookupEnv k

firstEnv :: [String] -> IO (Maybe String)
firstEnv ks = foldr (<|>) Nothing <$> mapM envNonEmpty ks

-- $YOLO_NAME, else the old $AGENT_SANDBOX_NAME, else the default.
opt :: String -> String -> IO String
opt name def = fromMaybe def <$> firstEnv ["YOLO_" ++ name, "AGENT_SANDBOX_" ++ name]

isVarName :: String -> Bool
isVarName k = case k of
  c : _ -> not (isDigit c) && all (\x -> isAlphaNum x || x == '_') k
  [] -> False

-- Run with output captured and dropped; just the exit code (127 if the
-- program is missing).
quiet :: FilePath -> [String] -> IO ExitCode
quiet cmd args = do
  r <- try (readProcessWithExitCode cmd args "")
  pure $ case r of
    Right (code, _, _) -> code
    Left e -> const (ExitFailure 127) (e :: IOException)

withUmask :: FileMode -> IO a -> IO a
withUmask mask act = bracket (setFileCreationMask mask) setFileCreationMask (const act)

readFileMaybe :: FilePath -> IO (Maybe String)
readFileMaybe f = do
  r <- try (readFile f >>= \s -> length s `seq` pure s)
  pure (either (\e -> const Nothing (e :: IOException)) Just r)

readMeta :: FilePath -> String -> IO String
readMeta f def = maybe def trim <$> readFileMaybe f

orElse :: IO a -> a -> IO a
orElse act def = either (\e -> const def (e :: IOException)) id <$> try act

trim :: String -> String
trim = dropWhileEnd isSpace . dropWhile isSpace

lastLine :: String -> Maybe String
lastLine s = case filter (not . null) (lines s) of
  [] -> Nothing
  ls -> Just (last ls)

secondsSince :: UTCTime -> IO Int
secondsSince t0 = (\t -> floor (diffUTCTime t t0)) <$> getCurrentTime
