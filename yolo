#!/usr/bin/env bash
# Run an agent in the sandboxed Docker/Podman environment.
#
# Usage:
#   yolo [OPTIONS] [DOCKER_FLAGS] -- [AGENT_ARGS...]
#
# Options:
#   --runtime claude|qwen   Agent runtime (default: claude)
#
# Mount additional directories with -v flags before --:
#   yolo -v /path/to/other:/workspace/other -- -p "do the thing"
#
# ANTHROPIC_API_KEY, SSH_AUTH_SOCK, and GIT_SIGNING_KEY are passed through from the environment.
# QWEN_API_KEY is passed through for --runtime qwen.
# CLAUDE_SESSIONS defaults to the OS-appropriate data dir; override to store sessions elsewhere.
# CONTAINER_RUNTIME can be set to "docker" or "podman" to override auto-detection.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
IMAGE="yolo:local"
RUNTIME="claude"

if [ -z "${CONTAINER_RUNTIME:-}" ]; then
  if command -v docker &>/dev/null; then
    CONTAINER_RUNTIME=docker
  elif command -v podman &>/dev/null; then
    CONTAINER_RUNTIME=podman
  else
    echo "error: neither docker nor podman found in PATH" >&2
    exit 1
  fi
fi

# Parse --runtime flag before --, split rest at -- into docker flags and cmd
docker_flags=()
cmd=()
found_sep=false
for arg in "$@"; do
  if [[ "$arg" == "--" ]]; then
    found_sep=true
  elif $found_sep; then
    cmd+=("$arg")
  elif [[ "$arg" == "--runtime" ]]; then
    RUNTIME="${2:?--runtime requires a value: claude or qwen}"
    shift
  else
    docker_flags+=("$arg")
  fi
done

# Validate runtime
case "$RUNTIME" in
  claude|qwen) ;;
  *) echo "error: --runtime must be 'claude' or 'qwen', got '$RUNTIME'" >&2; exit 1 ;;
esac

# Select Dockerfile based on runtime
DOCKERFILE="$SCRIPT_DIR/docker/Dockerfile.$RUNTIME"
if [ ! -f "$DOCKERFILE" ]; then
  echo "error: $DOCKERFILE not found" >&2
  exit 1
fi

"$CONTAINER_RUNTIME" build --progress=plain -t "$IMAGE" -f "$DOCKERFILE" "$SCRIPT_DIR/docker"

if [ -z "${GITHUB_TOKEN:-}" ]; then
  echo "error: GITHUB_TOKEN is not set" >&2
  exit 1
fi

ssh_flags=()
# Podman machine on macOS uses VirtioFS which cannot forward Unix domain sockets.
# Instead, encode the private key as base64 and start an in-container ssh-agent.
# Set SSH_PRIVATE_KEY_FILE to a key path, or SSH_PRIVATE_KEY to pre-encoded content.
if [ "$CONTAINER_RUNTIME" = "podman" ] && [[ "${OSTYPE:-}" == darwin* ]]; then
  if [ -n "${SSH_PRIVATE_KEY_FILE:-}" ] && [ -z "${SSH_PRIVATE_KEY:-}" ]; then
    SSH_PRIVATE_KEY=$(base64 < "$SSH_PRIVATE_KEY_FILE")
  elif [ -z "${SSH_PRIVATE_KEY:-}" ] && [ -n "${SSH_AUTH_SOCK:-}" ]; then
    echo "warning: SSH agent socket cannot be forwarded with podman on macOS; set SSH_PRIVATE_KEY_FILE or SSH_PRIVATE_KEY to enable SSH in the container" >&2
  fi
else
  if [ -z "${SSH_AUTH_SOCK:-}" ]; then
    echo "error: SSH_AUTH_SOCK is not set (is ssh-agent running?)" >&2
    exit 1
  fi
  ssh_flags+=(-v "$SSH_AUTH_SOCK:/ssh-agent" -e SSH_AUTH_SOCK=/ssh-agent)
  if [ -f "${HOME}/.ssh/allowed_signers" ]; then
    ssh_flags+=(-v "${HOME}/.ssh/allowed_signers:/root/.ssh/allowed_signers:ro")
  fi
fi

# Session/config data dir — differs by runtime
if [ -z "${CLAUDE_SESSIONS:-}" ]; then
  case "${OSTYPE:-}" in
    darwin*)  CLAUDE_SESSIONS="$HOME/Library/Application Support/yolo/sessions" ;;
    msys*|cygwin*|win32*) CLAUDE_SESSIONS="${APPDATA:-$HOME/AppData/Roaming}/yolo/sessions" ;;
    *)        CLAUDE_SESSIONS="${XDG_DATA_HOME:-$HOME/.local/share}/yolo/sessions" ;;
  esac
fi
mkdir -p "$CLAUDE_SESSIONS"

if [ "$RUNTIME" = "qwen" ]; then
  sessions_flags=(-v "$CLAUDE_SESSIONS:/root/.qwen/projects")
  config_mount="/root/.qwen/projects"
else
  sessions_flags=(-v "$CLAUDE_SESSIONS:/root/.claude/projects")
  config_mount="/root/.claude/projects"
fi

"$CONTAINER_RUNTIME" run --rm -it \
  -e ANTHROPIC_API_KEY \
  -e GITHUB_TOKEN \
  -e GIT_EMAIL="${GIT_EMAIL:-}" \
  -e GIT_NAME="${GIT_NAME:-}" \
  -e GIT_SIGNING_KEY="${GIT_SIGNING_KEY:-}" \
  -e QWEN_API_KEY="${QWEN_API_KEY:-}" \
  -e RUNTIME="$RUNTIME" \
  -e SSH_PRIVATE_KEY="${SSH_PRIVATE_KEY:-}" \
  -e HOST_UID="$(id -u)" \
  -e HOST_GID="$(id -g)" \
  "${ssh_flags[@]}" \
  "${sessions_flags[@]}" \
  -w /workspace \
  "${docker_flags[@]}" \
  "$IMAGE" \
  "${cmd[@]}"
