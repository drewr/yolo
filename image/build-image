#!/usr/bin/env bash
# Build agent images on the EC2 build box and pin them in image/images.
#
#   yolo build claude [codex ...] [--class unikernel|general-purpose]
#
# One image per harness named. unikernel (default): infra/buildbox/ec2/build.sh,
# pinned in image/images. general-purpose: a standard linux/amd64 image from
# infra/buildbox/ec2/build-oci.sh, pinned in image/images-general-purpose.
# Pins llm-agents and nixpkgs to the dotfiles' revisions first (sync-pins).
# The build context is image/. The box must be running; its ticket comes from
# $BUILDBOX_TICKET or ~/.local/state/agent-sandbox-build.
set -euo pipefail
HERE=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
ROOT=$(cd "$HERE/.." && pwd)
STATE=${XDG_STATE_HOME:-$HOME/.local/state}/agent-sandbox-build
REGISTRY=${AGENT_IMAGE_REGISTRY:-ghcr.io/drewr}
class=unikernel harnesses=()
while [ $# -gt 0 ]; do
  case $1 in
    --class) class=$2; shift 2 ;;
    *) harnesses+=("$1"); shift ;;
  esac
done
[ ${#harnesses[@]} -gt 0 ] || { sed -n '2,11p' "$0" | sed 's/^# \{0,1\}//'; exit 2; }
case $class in
  unikernel) images=$HERE/images tag=dev ;;
  general-purpose) images=$HERE/images-general-purpose tag=gp-dev ;;
  *) echo "build-image: unknown class '$class' (unikernel or general-purpose)" >&2; exit 2 ;;
esac
if [ -z "${BUILDBOX_TICKET:-}" ]; then
  BUILDBOX_TICKET=$(cat "$STATE/buildbox-ticket" 2>/dev/null) \
    || { echo "build-image: no BUILDBOX_TICKET (infra/buildbox/ec2/provision.sh ticket)" >&2; exit 1; }
fi
export BUILDBOX_TICKET
mkdir -p "$STATE/logs"
command -v dumbpipe >/dev/null || PATH="$(nix build --no-link --print-out-paths nixpkgs#dumbpipe)/bin:$PATH"

# Same llm-agents and nixpkgs as the dotfiles.
"$HERE/sync-pins"

rc=0
for h in "${harnesses[@]}"; do
  log="$STATE/logs/build-$h-$class.log"
  SECONDS=0
  if [ "$class" = general-purpose ]; then
    build=("$ROOT/infra/buildbox/ec2/build-oci.sh" "$HERE" "$REGISTRY/agent-$h:$tag" --opt "build-arg:HARNESS=$h")
  else
    build=("$ROOT/infra/buildbox/ec2/build.sh" "$HERE" "$REGISTRY/agent-$h:$tag" --build-arg "HARNESS=$h")
  fi
  if "${build[@]}" > "$log" 2>&1; then
    ref=$(grep -o "$REGISTRY/agent-$h@sha256:[0-9a-f]*" "$log" | tail -1)
  else
    ref=
  fi
  if [ -n "$ref" ]; then
    [ -f "$images" ] || printf '# One pinned image per harness for the %s class (yolo build HARNESS --backend datum --class %s).\n' "$class" "$class" > "$images"
    sed -i "/^$h /d" "$images"
    printf '%-9s %s\n' "$h" "$ref" >> "$images"
    echo "$h: $ref (${SECONDS}s)"
  else
    echo "$h: FAILED after ${SECONDS}s: $(grep -iE 'error' "$log" | tail -1 | cut -c1-200) (log: $log)" >&2
    rc=1
  fi
done
exit $rc
