#!/usr/bin/env bash
# Build agent images on the EC2 build box and pin them in image/images.
#
#   yolo build claude [codex ...]     one image per harness named
#
# Pins llm-agents and nixpkgs to the dotfiles' revisions first (sync-pins).
# The build context is image/; the flake takes the dotfiles' zsh config from
# its `dotfiles` input. Uses infra/buildbox/ec2/build.sh, so the box must be
# running; its ticket comes from $BUILDBOX_TICKET or
# ~/.local/state/agent-sandbox-build.
set -euo pipefail
HERE=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
ROOT=$(cd "$HERE/.." && pwd)
STATE=${XDG_STATE_HOME:-$HOME/.local/state}/agent-sandbox-build
REGISTRY=${AGENT_IMAGE_REGISTRY:-ghcr.io/drewr}
[ $# -gt 0 ] || { sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'; exit 2; }
if [ -z "${BUILDBOX_TICKET:-}" ]; then
  BUILDBOX_TICKET=$(cat "$STATE/buildbox-ticket" 2>/dev/null) \
    || { echo "build-image: no BUILDBOX_TICKET (infra/buildbox/ec2/provision.sh ticket)" >&2; exit 1; }
fi
export BUILDBOX_TICKET
mkdir -p "$STATE/logs"
command -v dumbpipe >/dev/null || PATH="$(nix build --no-link --print-out-paths nixpkgs#dumbpipe)/bin:$PATH"

# Same llm-agents and nixpkgs as the dotfiles.
"$HERE/sync-pins"

rc=0
for h in "$@"; do
  log="$STATE/logs/build-$h.log"
  SECONDS=0
  if "$ROOT/infra/buildbox/ec2/build.sh" "$HERE" "$REGISTRY/agent-$h:dev" --build-arg "HARNESS=$h" > "$log" 2>&1; then
    ref=$(grep -o "$REGISTRY/agent-$h@sha256:[0-9a-f]*" "$log" | tail -1)
  else
    ref=
  fi
  if [ -n "$ref" ]; then
    sed -i "/^$h /d" "$HERE/images"
    printf '%-9s %s\n' "$h" "$ref" >> "$HERE/images"
    echo "$h: $ref (${SECONDS}s)"
  else
    echo "$h: FAILED after ${SECONDS}s: $(grep -iE 'error' "$log" | tail -1 | cut -c1-200) (log: $log)" >&2
    rc=1
  fi
done
exit $rc
