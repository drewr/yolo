#!/bin/sh
# The jump image's helper. Only the jump image has it.
#
#   jump setup   run as root by init.sh, after the login user and
#                /etc/agent/env exist; needs U, UID_ and GID_ from init.sh
#   jump login   the forced command of every authorized key (init.sh writes it);
#                runs as the login user. The client's command picks:
#                  (none)       the shared tmux session "main"
#                  attach NAME  the tmux session NAME
#                  load         add the private key on stdin to the persistent
#                               agent and store it in Config (ssh BOX load < KEY)
#                  connect DEST ssh -A DEST in a tmux session named for it
#                  register NAME  an ssh Host entry for a yolo sandbox or any
#                               host, from its connection details on stdin, and
#                               recorded in Config (yolo jump BOX connect does both)
#                  seal ID      the broker's secret ID: a tokenizer secret (JSON) on
#                               stdin, sealed for the broker and stored in Config
#                  rules        the broker's default rules for new sandboxes (TOML on stdin)
#                  anything else, run by sh
#
# Agents: setup starts, as the login user and supervised,
#   - the persistent ssh-agent at $RUN/persist.sock. It is the one agent for
#     logins, tmux panes and held connections. Keys live only in its memory;
#     each start refills it from the keys stored in Config (restore_keys).
#   - a separate ssh-agent at $RUN/thismachine.sock for this machine's own key,
#     used only by ssh on this machine (IdentityAgent), never forwarded. Keys
#     added with a destination restriction (ssh-add -h) sign only when the agent
#     is asked directly, so this one is kept apart from the persistent agent.
# No client's agent is forwarded to the box. login ignores a forwarded
# SSH_AUTH_SOCK and exports the persistent agent's socket to everything it
# starts, so a tmux pane keeps working after the device that started it
# disconnects.
# Config (YOLO_CONFIG_URL, written by init.sh) keeps what must survive a
# restart: the keys (ssh-key-FINGERPRINT, secret) from load, and the
# connections (conn.NAME) from register. Without it, both stay in memory only.
# On Datum, setup writes the box's service-account credentials (from
# YOLO_DATUM_CREDENTIALS_JSON) to $RUN, mode 0600, points
# YOLO_DATUM_CREDENTIALS at that file, and logs datumctl in with it as the login
# user, with no context: the box's account can't read its organization, and yolo
# passes the project of YOLO_CONFIG_URL to datumctl as --project (YOLO_DATUM_PROJECT,
# which setup adds to the env file), so no `ctx use` is needed. With
# YOLO_DATUM_PULL_SECRET (the name of the image pull Secret, set by the client
# that made the box), setup adds it to the env file too, so the box's yolo can
# give its sandboxes the pull Secret.
#
# With the broker in the image (/bin/yolo-broker, /bin/tokenizer), setup also runs,
# as root, the tokenizer (user yolo-tok) and the broker (user yolo-broker), both
# supervised, with their store in /run/yolo-broker (a tmpfs). Their keys come from
# Config and go only into their own environments. The store is rebuilt from the
# broker-* entries of Config at each boot and whenever broker-gen changes.
# broker/README.md has the layout.
#
# JUMP_RUN, JUMP_ENV, JUMP_BROKER_RUN and JUMP_BROKER_OWNER are overridable for
# tests only.
RUN=${JUMP_RUN:-/run/yolo}
ENVF=${JUMP_ENV:-/etc/agent/env}
BRUN=${JUMP_BROKER_RUN:-/run/yolo-broker}
BSTORE=$BRUN/store
BOWN=${JUMP_BROKER_OWNER:-yolo-broker:yolo-broker}
TOK_ADDR=127.0.0.1:8080
TOK_URL=http://$TOK_ADDR

# A Datum organization or project name: non-empty, of [A-Za-z0-9._-].
valid_datum_name() {
  case $1 in ''|*[!A-Za-z0-9._-]*) return 1 ;; esac
}

# datumctl for the login user, as the box's service account. `yolo new` on this box
# runs datumctl as that user with --project, so the login needs no context: the
# box's account can't read its organization, and `ctx use` would need it. The
# project goes to the env file as YOLO_DATUM_PROJECT for yolo to pass on. The
# config goes in the login user's HOME, which must be in memory: a shared home
# (JuiceFS) would keep the credentials. After the login, the compute plugin the
# image installs is trusted (`yolo logs` on this box runs `datumctl compute
# logs`, and datumctl blocks a plugin it didn't install until it is trusted).
# Quiet on success, never fatal, and datumctl's output is dropped since it may
# hold tokens. CREDENTIALS is the file setup wrote.
datum_login() { # CREDENTIALS
  h=$(awk -F: -v u="$U" '$1 == u { print $6; exit }' /etc/passwd)
  project=${YOLO_CONFIG_URL#datum://}
  project=${project%%/*}
  if ! valid_datum_name "$project"; then
    echo "[jump] datum: no project to log $U in to (YOLO_CONFIG_URL); datumctl isn't logged in" >&2
    return 0
  fi
  printf 'export YOLO_DATUM_PROJECT=%s\n' "$project" >> "$ENVF"
  case $h in
    ''|/)
      echo "[jump] datum: $U has no home; datumctl isn't logged in" >&2
      return 0 ;;
  esac
  case $(readlink -f "$h") in
    /mnt/agent-fs|/mnt/agent-fs/*)
      echo "[jump] datum: $U's home is the shared home, not memory; datumctl isn't logged in" >&2
      return 0 ;;
  esac
  if ! as_user "HOME=$h datumctl login --credentials $1 >/dev/null 2>&1"; then
    echo "[jump] datum: datumctl login failed for $U; yolo new on this box won't reach Datum" >&2
    return 0
  fi
  if ! as_user "HOME=$h datumctl plugin trust compute >/dev/null 2>&1"; then
    echo "[jump] datum: can't trust the compute plugin for $U; yolo logs on this box won't work" >&2
  fi
  return 0
}

setup() {
  export PATH=/bin
  : "${U:?}" "${UID_:?}" "${GID_:?}"
  # The box's own iroh key is the SSH listener's alone. Everything started here
  # (agents, tmux, held connections) must not inherit it: a dumbpipe connect
  # with the listener's key knocks the listener off the relay, and the box
  # becomes unreachable.
  unset IROH_SECRET
  as_user() { /bin/su "$U" -s /bin/sh -c "$1"; }
  # A supervised ssh-agent at $RUN/SOCK, as the user. Each start runs ONSTART
  # (if given) in the background, e.g. to put the stored keys back.
  agent() { # SOCK LABEL [ONSTART]
    (
      while :; do
        rm -f "$RUN/$1"
        [ -n "${3:-}" ] && "$3" &
        as_user "exec /bin/ssh-agent -D -a $RUN/$1 >/dev/null"
        echo "[jump] $2 exited rc=$?; restarting"
        sleep 2
      done
    ) &
  }

  # No core files from the agent or anything else holding keys.
  # shellcheck disable=SC3045  # busybox sh has it
  ulimit -c 0 2>/dev/null

  # Sockets, config and anything key-shaped under $RUN stay in memory, also on
  # a runtime class whose root filesystem is a disk.
  if ! awk -v d="$RUN" '$2 == d && $3 == "tmpfs" { f = 1 } END { exit !f }' /proc/mounts; then
    mkdir -p "$RUN" && mount -t tmpfs -o mode=0700,size=64m tmpfs "$RUN" \
      || echo "[jump] WARNING: $RUN is not in memory (tmpfs mount failed)"
  fi
  chown -R "$UID_:$GID_" "$RUN"
  chmod 700 "$RUN"

  # The Config address. init.sh has written it to the env file for logins; take
  # that line only, since the file also holds the provider keys.
  [ -n "${YOLO_CONFIG_URL:-}" ] || eval "$(sed -n '/^export YOLO_CONFIG_URL=/p' "$ENVF" 2>/dev/null)"
  [ -n "${YOLO_TOKENIZER_CONFIG_URL:-}" ] || eval "$(sed -n '/^export YOLO_TOKENIZER_CONFIG_URL=/p' "$ENVF" 2>/dev/null)"
  if [ -n "${YOLO_DATUM_CREDENTIALS_JSON:-}" ]; then
    # The credentials are the box's own service account. The file is created
    # with umask 077 and owned by the login user, so it is never readable by
    # anyone else, not even briefly. Its content is never printed.
    c=$RUN/datum-credentials.json
    rm -f "$c"
    if (umask 077 && printf '%s\n' "$YOLO_DATUM_CREDENTIALS_JSON" > "$c") \
      && chown "$UID_:$GID_" "$c" && chmod 600 "$c"; then
      export YOLO_DATUM_CREDENTIALS="$c"
      printf 'export YOLO_DATUM_CREDENTIALS=%s\n' "$c" >> "$ENVF"
      echo "[jump] datum: credentials for the box's service account are in $RUN"
      datum_login "$c"
    else
      echo "[jump] datum: can't write the credentials to $RUN; Config won't work" >&2
    fi
  else
    echo "[jump] no Datum credentials; load and register won't persist"
  fi
  # dropbear doesn't pass the container's env to logins, so yolo on the box gets
  # the pull Secret's name through the env file, as it gets YOLO_DATUM_PROJECT.
  if [ -n "${YOLO_DATUM_PULL_SECRET:-}" ]; then
    if valid_datum_name "$YOLO_DATUM_PULL_SECRET"; then
      printf 'export YOLO_DATUM_PULL_SECRET=%s\n' "$YOLO_DATUM_PULL_SECRET" >> "$ENVF"
    else
      echo "[jump] datum: YOLO_DATUM_PULL_SECRET isn't a valid Secret name; sandboxes can't pull private images" >&2
    fi
  fi
  unset YOLO_DATUM_CREDENTIALS_JSON
  [ -n "${YOLO_CONFIG_URL:-}" ] || echo "[jump] no Config (YOLO_CONFIG_URL); keys and connections stay in memory"

  agent persist.sock "persistent agent" restore_keys
  agent thismachine.sock "this machine's agent"
  echo "[jump] persistent agent on $RUN/persist.sock"
  restore_connections &
  # Backgrounded: the open key and the store can wait out a network that is not up
  # yet, and init.sh does not start sshd until setup returns.
  broker &
}

# `yolo cfg list [--secret]` on stdout, retried with backoff (1s to 16s): the
# network may not be up yet at boot.
cfg_list() {
  d=1 n=0
  until out=$(/bin/yolo cfg list "$@"); do
    n=$((n + 1))
    [ "$n" -ge 6 ] && return 1
    sleep "$d"
    d=$((d * 2))
  done
  printf '%s\n' "$out"
}

# The stored keys (ssh-key-* in the box's Secret, written by `load`) into the
# persistent agent, whenever that agent starts. Runs as root: it reads Config
# with the box's credentials, and root may use the user's agent.
restore_keys() {
  [ -n "${YOLO_CONFIG_URL:-}" ] || return 0
  i=0
  until [ -S "$RUN/persist.sock" ] || [ $i -ge 50 ]; do sleep 0.2; i=$((i + 1)); done
  keys=$(cfg_list --secret) || { echo "[jump] can't list the stored keys; none loaded"; return 0; }
  n=0
  for k in $keys; do
    case $k in ssh-key-*) ;; *) continue ;; esac
    if /bin/yolo cfg get --secret "$k" | SSH_AUTH_SOCK=$RUN/persist.sock ssh-add -q - 2>/dev/null; then
      n=$((n + 1))
    else
      echo "[jump] could not load $k"
    fi
  done
  echo "[jump] persistent agent: $n stored key(s) loaded"
}

# Every connection in the box's Config (conn.NAME, written by `register`): its
# ssh Host entry, then a tmux session holding it, as at `connect`.
restore_connections() {
  [ -n "${YOLO_CONFIG_URL:-}" ] || return 0
  names=$(cfg_list) || { echo "[jump] can't list the stored connections; none restored"; return 0; }
  for c in $names; do
    case $c in conn.*) ;; *) continue ;; esac
    name=${c#conn.}
    case $name in ''|-*|*[!A-Za-z0-9._-]*) echo "[jump] skipping $c: bad name"; continue ;; esac
    p=$(/bin/yolo cfg get "$c") || { echo "[jump] can't read $c"; continue; }
    dest=$(printf '%s\n' "$p" | sed -n 's/^dest=//p' | head -1)
    valid_dest "$dest" 2>/dev/null || { echo "[jump] skipping $c: bad dest"; continue; }
    printf '%s\n' "$p" | as_user "JUMP_RUN=$RUN /bin/sh /bin/jump register-local $name" >/dev/null \
      && as_user "JUMP_RUN=$RUN /bin/sh /bin/jump hold $dest" \
      && echo "[jump] reconnecting $name ($dest)"
  done
}

# The credential broker and its tokenizer (broker/README.md). Only where the image
# ships them and the box has its Config. Each daemon runs as its own user, and a
# key goes only into the environment of the process that needs it.
broker_skip() { echo "[jump] WARNING: broker skipped: $*" >&2; }

# `yolo cfg get` into V: URL [--secret] KEY. Returns 0 with V set, 3 when the entry
# is missing, 1 when it gave up. Other failures (the network may not be up at boot)
# are retried with backoff, 1s to 16s, as cfg_list does.
cfg_fetch() {
  [ -n "$1" ] || return 1
  u=$1; shift
  wait=1 n=0
  while :; do
    V=$(YOLO_CONFIG_URL=$u /bin/yolo cfg get "$@"); rc=$?
    if [ "$rc" -eq 0 ] || [ "$rc" -eq 3 ]; then return "$rc"; fi
    n=$((n + 1))
    if [ "$n" -ge 6 ]; then echo "[jump] broker: can't read $* (rc=$rc)" >&2; return 1; fi
    sleep "$wait"
    wait=$((wait * 2))
  done
}

# Stdin into Config as KEY: URL [--secret] KEY. Retried like cfg_fetch; 1 when it
# can't store. The value is read once, so a retry stores the same bytes.
cfg_put() {
  [ -n "$1" ] || return 1
  u=$1; shift
  v=$(cat)
  wait=1 n=0
  until printf '%s\n' "$v" | YOLO_CONFIG_URL=$u /bin/yolo cfg put "$@"; do
    n=$((n + 1))
    if [ "$n" -ge 6 ]; then echo "[jump] broker: can't store $*" >&2; return 1; fi
    sleep "$wait"
    wait=$((wait * 2))
  done
}

# 32 random bytes as 64 hex characters: an iroh secret key, or the open key.
random_key() { head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n'; }

# A new broker-gen: the time and two random bytes, so a change is always new.
broker_gen_bump() {
  printf '%s-%s\n' "$(date +%s)" "$(head -c 2 /dev/urandom | od -An -tx1 | tr -d ' \n')"
}

# Whether a passwd or group FILE has the numeric id $2 in its third field.
id_taken() { awk -F: -v i="$2" '$3 == i { f = 1 } END { exit !f }' "$1"; }

# A system user and group NAME with ID, appended unless NAME is already a user.
add_account() {
  grep -q "^$1:" /etc/passwd && return 0
  if id_taken /etc/passwd "$2" || id_taken /etc/group "$2"; then
    echo "[jump] broker: id $2 is taken; can't add $1" >&2
    return 1
  fi
  grep -q "^$1:" /etc/group || echo "$1:x:$2:" >> /etc/group
  echo "$1:x:$2:$2:$1:/nonexistent:/bin/false" >> /etc/passwd
}

broker_users() { add_account yolo-broker 990 && add_account yolo-tok 991; }

# /run/yolo-broker: the store and the broker's files, in memory, owned by its user.
broker_dir() {
  if ! awk -v d="$BRUN" '$2 == d && $3 == "tmpfs" { f = 1 } END { exit !f }' /proc/mounts; then
    mkdir -p "$BRUN" || return 1
    mount -t tmpfs -o mode=0700,size=16m tmpfs "$BRUN" \
      || { echo "[jump] broker: $BRUN is not in memory" >&2; return 1; }
  fi
  chown "$BOWN" "$BRUN" && chmod 700 "$BRUN"
}

# The tokenizer's open key into OPEN_KEY, from its own Config. A missing entry
# (exit 3) makes a new key, stored before anything runs with it. Any other failure
# gives up: a new key would make every sealed secret unreadable.
open_key() {
  cfg_fetch "$YOLO_TOKENIZER_CONFIG_URL" --secret open-key; rc=$?
  if [ "$rc" -eq 0 ]; then OPEN_KEY=$V; return 0; fi
  [ "$rc" -eq 3 ] || return 1
  echo "[jump] broker: no tokenizer open key yet; making one"
  OPEN_KEY=$(random_key)
  printf '%s\n' "$OPEN_KEY" | cfg_put "$YOLO_TOKENIZER_CONFIG_URL" --secret open-key
}

# Unexport everything but PATH and the variables named in $1 (space-separated), in
# the calling subshell: a daemon gets only what it needs, not setup's environment
# (provider keys, credentials, the box's iroh key).
only_env() {
  for name in $(env | sed -n 's/^\([A-Za-z_][A-Za-z0-9_]*\)=.*/\1/p'); do
    case " PATH $1 " in *" $name "*) continue ;; esac
    unset "$name" 2>/dev/null
  done
}

# Run CMD as USER with su, restarted whenever it exits. The caller exports what CMD
# needs inside its own subshell and names it in KEEP; nothing reaches a command line.
supervise() { # LABEL USER CMD KEEP
  (
    only_env "$4"
    while :; do
      /bin/su "$2" -s /bin/sh -c "$3"
      echo "[jump] $1 exited rc=$?; restarting"
      sleep 2
    done
  ) &
}

# The tokenizer, as yolo-tok, on localhost. The open key is in its environment only.
start_tokenizer() {
  (
    export OPEN_KEY LISTEN_ADDRESS=$TOK_ADDR
    supervise tokenizer yolo-tok "exec /bin/tokenizer serve" "OPEN_KEY LISTEN_ADDRESS"
  )
}

# The seal key (public) that `seal` seals to, stored as broker-seal-key. tokenizer
# prints it on stderr only, as `export SEAL_KEY=HEX`.
publish_seal_key() {
  out=$(OPEN_KEY=$OPEN_KEY /bin/tokenizer sealkey 2>&1) || return 1
  sk=$(printf '%s\n' "$out" | sed -n 's/^export SEAL_KEY=//p')
  [ "${#sk}" -eq 64 ] || { echo "[jump] broker: tokenizer printed no seal key" >&2; return 1; }
  printf '%s\n' "$sk" | cfg_put "$YOLO_CONFIG_URL" broker-seal-key
}

# The store's first boot: its CA, tokenizer password and iroh key are made once and
# kept in Config. Only a missing broker-tokenizer-password (exit 3) starts that. Any
# other failure gives up: a second init would replace the CA and password that the
# sealed secrets depend on. The password is stored last, so its presence means the
# rest is there.
broker_first_boot() {
  cfg_fetch "$YOLO_CONFIG_URL" --secret broker-tokenizer-password; rc=$?
  [ "$rc" -eq 0 ] && return 0
  [ "$rc" -eq 3 ] || return 1
  echo "[jump] broker: first boot; making its CA, tokenizer password and key"
  d=$BRUN/init
  rm -rf "$d"
  (umask 077; mkdir "$d") || return 1
  /bin/yolo-broker init --store "$d/store" --tokenizer-url "$TOK_URL" >/dev/null \
    || { rm -rf "$d"; return 1; }
  ca=$(cat "$d/store/ca.pem"); cak=$(cat "$d/store/ca.key"); pw=$(cat "$d/store/tokenizer-password")
  bk=$(random_key)
  printf '%s\n' "$ca" | cfg_put "$YOLO_CONFIG_URL" broker-ca.pem; rc=$?
  [ "$rc" -eq 0 ] && { printf '%s\n' "$cak" | cfg_put "$YOLO_CONFIG_URL" --secret broker-ca.key; rc=$?; }
  [ "$rc" -eq 0 ] && { printf '%s\n' "$bk" | cfg_put "$YOLO_CONFIG_URL" --secret broker-key; rc=$?; }
  [ "$rc" -eq 0 ] && { printf '%s\n' "$pw" | cfg_put "$YOLO_CONFIG_URL" --secret broker-tokenizer-password; rc=$?; }
  rm -rf "$d"
  return "$rc"
}

# FILE becomes CONTENT, mode MODE, unless it already is. The new copy is written
# beside it as a dot file and renamed into place, so a reader sees the old file or
# the new one. Sets broker_changed=1 when it replaced the file.
store_file() { # CONTENT FILE MODE
  t=${2%/*}/.${2##*/}.tmp
  (umask 077; printf '%s\n' "$1" > "$t") || { rm -f "$t"; return 1; }
  if cmp -s "$t" "$2"; then rm -f "$t"; return 0; fi
  if chmod "$3" "$t" && chown "$BOWN" "$t" && mv -f "$t" "$2"; then
    broker_changed=1
    return 0
  fi
  rm -f "$t"
  return 1
}

# Config entry KEY (a secret when SECRET is 1) into the store file NAME, mode MODE.
store_entry() { # SECRET KEY NAME MODE
  if [ "$1" = 1 ]; then cfg_fetch "$YOLO_CONFIG_URL" --secret "$2"; else cfg_fetch "$YOLO_CONFIG_URL" "$2"; fi || return 1
  store_file "$V" "$BSTORE/$3" "$4"
}

# policy.toml: every broker-sandbox.* entry, a blank line after each. Empty when
# there are none. It fails rather than give a short policy, which would cut off
# sandboxes that are still allowed.
sandbox_policy() {
  names=$(cfg_list) || return 1
  for k in $names; do
    case $k in broker-sandbox.*) ;; *) continue ;; esac
    cfg_fetch "$YOLO_CONFIG_URL" "$k" || return 1
    printf '%s\n\n' "$V"
  done
}

# secrets/ID for every broker-secret.ID entry. A file whose entry is gone is removed.
sync_secrets() {
  names=$(cfg_list --secret) || return 1
  keep=' '
  for k in $names; do
    case $k in broker-secret.*) ;; *) continue ;; esac
    id=${k#broker-secret.}
    valid_secret_id "$id" || { echo "[jump] broker: skipping $k: bad id" >&2; continue; }
    cfg_fetch "$YOLO_CONFIG_URL" --secret "$k" || return 1
    store_file "$V" "$BSTORE/secrets/$id" 600 || return 1
    keep="$keep$id "
  done
  for f in "$BSTORE"/secrets/*; do
    [ -e "$f" ] || continue
    id=${f##*/}
    case $keep in *" $id "*) ;; *) rm -f "$f" && broker_changed=1 ;; esac
  done
}

# The whole store, from Config (broker/README.md, "Store"). Sets broker_changed=1
# when any file changed, so the caller knows to reload the broker.
broker_sync() {
  broker_changed=0
  mkdir -p "$BSTORE/secrets" || return 1
  chown -R "$BOWN" "$BRUN" && chmod 700 "$BRUN" "$BSTORE" "$BSTORE/secrets" || return 1
  store_entry 1 broker-tokenizer-password tokenizer-password 600 || return 1
  store_entry 1 broker-ca.key ca.key 600 || return 1
  store_entry 0 broker-ca.pem ca.pem 644 || return 1
  store_file "$TOK_URL" "$BSTORE/tokenizer-url" 644 || return 1
  pol=$(sandbox_policy) || return 1
  store_file "$pol" "$BSTORE/policy.toml" 644 || return 1
  sync_secrets
}

# The broker, as yolo-broker, on the store. Its iroh key comes from the environment,
# so --key-file /dev/null is never read; if the variable were empty, serve would
# fail on it rather than make a new key in the working directory.
start_broker() {
  (
    export YOLO_BROKER_SECRET_KEY="$BKEY"
    supervise yolo-broker yolo-broker "cd $BRUN && exec /bin/yolo-broker serve --store $BSTORE --key-file /dev/null --log-format text" "YOLO_BROKER_SECRET_KEY"
  )
}

# broker-id into Config, and the broker's id and CA file for the login environment,
# which `yolo new` on this box reads.
publish_broker() {
  id=$(YOLO_BROKER_SECRET_KEY=$BKEY /bin/yolo-broker id --key-file /dev/null) || return 1
  printf '%s\n' "$id" | cfg_put "$YOLO_CONFIG_URL" broker-id || return 1
  cfg_fetch "$YOLO_CONFIG_URL" broker-ca.pem || return 1
  (umask 022; printf '%s\n' "$V" > "$RUN/broker-ca.pem") || return 1
  chown "$UID_:$GID_" "$RUN/broker-ca.pem" && chmod 644 "$RUN/broker-ca.pem" || return 1
  printf 'export YOLO_BROKER_ID=%s\n' "$id" >> "$ENVF"
  printf 'export YOLO_BROKER_CA_FILE=%s\n' "$RUN/broker-ca.pem" >> "$ENVF"
}

reload_broker() {
  for p in $(pidof yolo-broker); do kill -HUP "$p"; done
  echo "[jump] broker: store changed; reloaded"
}

# Every 10 s, when broker-gen changes: rebuild the store, and reload the broker if
# a file changed. A failed sync keeps the last seen gen, so it is retried.
broker_poll() {
  (
    seen=
    while :; do
      sleep 10
      g=$(YOLO_CONFIG_URL=$YOLO_CONFIG_URL /bin/yolo cfg get broker-gen 2>/dev/null) || continue
      [ "$g" = "$seen" ] && continue
      if broker_sync; then
        seen=$g
        if [ "$broker_changed" = 1 ]; then reload_broker; fi
      else
        echo "[jump] broker: store not synced; retrying in 10s" >&2
      fi
    done
  ) &
}

broker() {
  if [ ! -x /bin/yolo-broker ] || [ ! -x /bin/tokenizer ]; then
    echo "[jump] broker: not in this image; skipped"
    return 0
  fi
  if [ -z "${YOLO_CONFIG_URL:-}" ] || [ -z "${YOLO_TOKENIZER_CONFIG_URL:-}" ]; then
    echo "[jump] broker: needs YOLO_CONFIG_URL and YOLO_TOKENIZER_CONFIG_URL; skipped"
    return 0
  fi
  if ! broker_users || ! broker_dir || ! open_key; then
    broker_skip "users, $BRUN or the open key (see above)"
    return 0
  fi
  start_tokenizer
  publish_seal_key || echo "[jump] WARNING: broker-seal-key not stored; seal won't work until the next boot" >&2
  broker_first_boot; rc=$?
  [ "$rc" -eq 0 ] && { cfg_fetch "$YOLO_CONFIG_URL" --secret broker-key; rc=$?; }
  if [ "$rc" -ne 0 ]; then
    broker_skip "the broker's key (see above)"
    return 0
  fi
  BKEY=$V
  broker_sync || { broker_skip "the store (see above)"; return 0; }
  start_broker
  publish_broker || echo "[jump] WARNING: broker-id or the CA file not published" >&2
  unset OPEN_KEY BKEY V
  broker_poll
}

login() {
  # shellcheck disable=SC1090  # the session environment written by init.sh
  [ -r "$ENVF" ] && . "$ENVF"
  # The one agent everything this login starts (tmux panes, yolo, ssh) uses.
  # A forwarded SSH_AUTH_SOCK from the client is ignored.
  SSH_AUTH_SOCK=$RUN/persist.sock
  export SSH_AUTH_SOCK

  case ${SSH_ORIGINAL_COMMAND:-} in
    '')        tmux new-session -A -s main ;;
    "attach "*) tmux new-session -A -s "${SSH_ORIGINAL_COMMAND#attach }" ;;
    load)      load ;;
    "connect "*)  connect "${SSH_ORIGINAL_COMMAND#connect }" ;;
    "register "*) register "${SSH_ORIGINAL_COMMAND#register }" ;;
    "seal "*)  seal "${SSH_ORIGINAL_COMMAND#seal }" ;;
    rules)     rules ;;
    *)         /bin/sh -c "$SSH_ORIGINAL_COMMAND" ;;
  esac
  exit $?
}

# `ssh BOX load < KEY`: add the private key on stdin to the persistent agent,
# and store it in Config (ssh-key-FINGERPRINT, secret), from which the agent is
# refilled whenever it or the box restarts. The key passes through this shell's
# memory and, for ssh-keygen, a file on the $RUN tmpfs, removed at once.
# A key with a passphrase can't be loaded this way (no terminal to ask on).
load() {
  k=$(cat)
  if ! printf '%s\n' "$k" | SSH_AUTH_SOCK=$RUN/persist.sock ssh-add -q - 2>/dev/null; then
    echo "jump load: ssh-add refused the key (a passphrase, or not a private key?)" >&2
    return 1
  fi
  # ssh-keygen -l reads a private key only from a file: one on the tmpfs,
  # removed at once.
  kf=$RUN/.key.$$
  (umask 077; printf '%s\n' "$k" > "$kf")
  fp=$(ssh-keygen -l -f "$kf" | awk '{print $2}')
  rm -f "$kf"
  name=ssh-key-$(printf %s "${fp#SHA256:}" | tr '+/' '-_' | tr -d '=')
  if [ -n "${YOLO_CONFIG_URL:-}" ] && printf '%s\n' "$k" | /bin/yolo cfg put --secret "$name"; then
    echo "jump load: stored in Config as $name"
  else
    echo "jump load: in the agent, but NOT stored; it's gone after a restart" >&2
  fi
  SSH_AUTH_SOCK=$RUN/persist.sock ssh-add -l
}

# The tmux session name for a destination: tmux names can't hold . or :.
session_for() { printf %s "$1" | tr '.:@' '___'; }

valid_dest() {
  case $1 in
    ''|-*|*[!A-Za-z0-9@._:%+-]*) echo "jump: bad destination '$1'" >&2; return 2 ;;
  esac
}

# `hold DEST`: a detached tmux session (named for DEST) running hold_loop, so
# the connection outlives every login. Holding an already-held DEST is a no-op.
hold() {
  valid_dest "$1" || return
  s=$(session_for "$1")
  tmux has-session -t "=$s" 2>/dev/null && return 0
  tmux new-session -d -s "$s" env "JUMP_RUN=$RUN" /bin/sh /bin/jump hold-loop "$1"
}

# ssh to DEST, forwarding the persistent agent, and reconnect whenever it drops:
# after the host reboots, after the network goes, after this box restarts (setup
# re-holds every recorded connection). Keepalives notice a dead peer in about
# 30s; retries back off from 5s to 60s, and a connection that lasted a minute
# starts over at 5s. The agent is named explicitly, not taken from SSH_AUTH_SOCK.
# On DEST, ~/.ssh/agent.sock follows the current connection's agent, so what
# runs there keeps a working agent across reconnects.
hold_loop() {
  d=5
  while :; do
    t0=$(date +%s)
    # shellcheck disable=SC2016  # expanded on DEST
    ssh -t -o "IdentityAgent=$RUN/persist.sock" -o "ForwardAgent=$RUN/persist.sock" \
      -o ServerAliveInterval=15 -o ServerAliveCountMax=2 -o ConnectTimeout=20 "$1" \
      'mkdir -p ~/.ssh && ln -sfn "$SSH_AUTH_SOCK" ~/.ssh/agent.sock; exec "${SHELL:-/bin/sh}" -l'
    rc=$?
    [ $(($(date +%s) - t0)) -ge 60 ] && d=5
    echo "[jump] connection to $1 ended (rc=$rc); reconnecting in ${d}s, C-c to stop"
    sleep "$d"
    d=$((d * 2)); [ "$d" -gt 60 ] && d=60
  done
}

# `connect DEST`: hold DEST, then attach to that session. Running it again
# reattaches; detaching (or the device going away) leaves it held.
connect() {
  hold "$1" && tmux attach-session -t "=$(session_for "$1")"
}

# `register NAME`, with a host's connection details on stdin (all public;
# yolo jump BOX connect sends them), one key=value per line:
#   dest=        what to hold: USER@NAME, or NAME
#   alias=       the name its host key is pinned under (HostKeyAlias)
#   hostname=    to reach it directly (DNS name or IP), and port= if not 22
#   ticket=      or to reach it over iroh (a yolo sandbox, or a host running
#                dumbpipe listen-tcp)
#   known_hosts= its host key, "ALIAS TYPE KEY" (repeatable)
#   accept_new=1 no host key given: take the one the host offers now, once
# Writes its ssh Host entry (register_local) and records the details, with
# the host key resolved, as conn.NAME in the box's Config, from which the
# box re-registers and re-holds it after a restart.
register() {
  payload=$(cat)
  if printf '%s\n' "$payload" | grep -qx 'accept_new=1' && ! printf '%s\n' "$payload" | grep -q '^known_hosts='; then
    payload=$(printf '%s\n' "$payload" | accept_new) || return
  fi
  printf '%s\n' "$payload" | register_local "$1" || return
  if [ -n "${YOLO_CONFIG_URL:-}" ] && printf '%s\n' "$payload" | /bin/yolo cfg put "conn.$1"; then
    echo "jump register: recorded conn.$1 in Config"
  else
    echo "jump register: NOT recorded; $1 won't reconnect after a restart" >&2
  fi
}

# Trust on first use: the payload on stdin, minus accept_new, plus the host
# keys the host offers now (ssh-keyscan), under its alias.
accept_new() {
  p=$(cat)
  get() { printf '%s\n' "$p" | sed -n "s/^$1=//p" | head -1; }
  h=$(get hostname) port=$(get port) a=$(get alias)
  [ -n "$h" ] || { echo "jump register: accept_new needs hostname=" >&2; return 2; }
  keys=$(ssh-keyscan -T 10 -p "${port:-22}" -- "$h" 2>/dev/null | awk -v a="$a" '!/^#/ && NF >= 3 { print "known_hosts=" a " " $2 " " $3 }')
  [ -n "$keys" ] || { echo "jump register: no host key from $h" >&2; return 1; }
  echo "jump register: trusting $h's host key on first use:" >&2
  printf '%s\n' "$keys" | sed 's/^known_hosts=[^ ]* /  /' >&2
  printf '%s\n' "$p" | grep -vx 'accept_new=1'
  printf '%s\n' "$keys"
}

# An ssh Host entry NAME, from the details on stdin (see register), with its
# host key pinned. Entries live in ~/.ssh/yolo/, included from ~/.ssh/config.
register_local() {
  case $1 in ''|-*|*[!A-Za-z0-9._-]*) echo "jump register: bad name '$1'" >&2; return 2 ;; esac
  ticket='' alias='' host='' port='' kh=''
  while IFS= read -r line; do
    case $line in
      ticket=*) ticket=${line#ticket=} ;;
      alias=*) alias=${line#alias=} ;;
      hostname=*) host=${line#hostname=} ;;
      port=*) port=${line#port=} ;;
      known_hosts=*) kh="$kh${line#known_hosts=}
" ;;
    esac
  done
  case $alias in ''|-*|*[!A-Za-z0-9._-]*) echo "jump register: bad alias" >&2; return 2 ;; esac
  case $ticket in *[!a-z0-9]*) echo "jump register: bad ticket" >&2; return 2 ;; esac
  case $host in -*|*[!A-Za-z0-9.:-]*) echo "jump register: bad hostname" >&2; return 2 ;; esac
  case $port in *[!0-9]*) echo "jump register: bad port" >&2; return 2 ;; esac
  if [ -z "$ticket" ] && [ -z "$host" ]; then echo "jump register: need ticket= or hostname=" >&2; return 2; fi
  [ -n "$kh" ] || { echo "jump register: no host key (known_hosts=)" >&2; return 2; }
  if printf '%s' "$kh" | grep -v "^$alias [a-z0-9@.-]* [A-Za-z0-9+/=]*\$" | grep -q .; then
    echo "jump register: a known_hosts line isn't 'ALIAS TYPE KEY' for $alias" >&2; return 2
  fi
  d=$HOME/.ssh/yolo
  mkdir -p "$d" && chmod 700 "$HOME/.ssh" "$d"
  printf '%s' "$kh" > "$d/known_hosts.$1"
  {
    echo "Host $1"
    if [ -n "$ticket" ]; then
      echo "  HostName $alias"
      # Never with the box's own iroh key (see setup).
      echo "  ProxyCommand /bin/env -u IROH_SECRET /bin/dumbpipe connect $ticket 2>/dev/null"
    else
      echo "  HostName $host"
      [ -n "$port" ] && echo "  Port $port"
    fi
    echo "  HostKeyAlias $alias"
    echo "  UserKnownHostsFile $d/known_hosts.$1"
    echo "  StrictHostKeyChecking yes"
  } > "$d/$1.conf"
  # Include must come before any Host block to apply everywhere.
  inc='Include ~/.ssh/yolo/*.conf'
  if ! grep -qxF "$inc" "$HOME/.ssh/config" 2>/dev/null; then
    { echo "$inc"; cat "$HOME/.ssh/config" 2>/dev/null; } > "$HOME/.ssh/config.new"
    mv "$HOME/.ssh/config.new" "$HOME/.ssh/config"
  fi
  chmod 600 "$HOME/.ssh/config"
  echo "registered $1 (${ticket:+iroh}${host:+$host${port:+:$port}})"
}

# Valid as crates/broker/src/policy.rs valid_secret_id: 1 to 64 of [A-Za-z0-9_.-],
# not starting with a dot. A secret id names a file in the store.
valid_secret_id() {
  case $1 in ''|.*|*[!A-Za-z0-9_.-]*) return 1 ;; esac
  [ "${#1}" -le 64 ]
}

# `ssh BOX seal ID < SECRET.json`: seal a tokenizer secret for the broker and store
# it in Config as broker-secret.ID, then bump broker-gen so the broker reloads.
seal() {
  valid_secret_id "$1" || { echo "jump seal: bad id '$1'" >&2; return 2; }
  ( seal_secret "$1" )
}

# The JSON on stdin goes straight to yolo-broker seal, in a throwaway store on $RUN
# that is removed on every exit. None of it reaches a command line.
seal_secret() { # ID
  d=$RUN/seal.$$
  trap 'rm -rf "$d"' EXIT
  trap 'exit 1' HUP INT TERM
  (umask 077; mkdir -p "$d/secrets") || return 1
  cfg_fetch "$YOLO_CONFIG_URL" --secret broker-tokenizer-password || {
    echo "jump seal: the broker isn't set up on this box" >&2; return 1; }
  (umask 077; printf '%s\n' "$V" > "$d/tokenizer-password") || return 1
  cfg_fetch "$YOLO_CONFIG_URL" broker-seal-key || { echo "jump seal: no seal key yet" >&2; return 1; }
  /bin/yolo-broker seal --seal-key "$V" --store "$d" --id "$1" --json-file - >/dev/null || {
    echo "jump seal: yolo-broker refused the secret" >&2; return 1; }
  cfg_put "$YOLO_CONFIG_URL" --secret "broker-secret.$1" < "$d/secrets/$1" || return 1
  broker_gen_bump | cfg_put "$YOLO_CONFIG_URL" broker-gen || return 1
  echo "sealed $1"
}

# `ssh BOX rules < RULES.toml`: the default rules for new sandboxes (broker-rules).
rules() {
  v=$(cat)
  [ -n "$v" ] || { echo "jump rules: empty" >&2; return 2; }
  printf '%s\n' "$v" | cfg_put "$YOLO_CONFIG_URL" broker-rules && echo "jump rules: stored"
}

case ${1:-} in
  setup) setup ;;
  login) login ;;
  # Used by setup to restore saved connections, as the login user.
  register-local) register_local "${2:-}" ;;
  hold) hold "${2:-}" ;;
  hold-loop) hold_loop "${2:?}" ;;
  *) echo "usage: jump setup|login" >&2; exit 2 ;;
esac
