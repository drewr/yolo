#!/bin/sh
# The jump image's helper. Only the jump image has it.
#
#   jump setup   run as root by init.sh, after the login user and
#                /etc/agent/env exist; needs U, UID_ and GID_ from init.sh
#   jump login   the forced command of every authorized key (init.sh writes it);
#                runs as the login user. The client's command picks:
#                  (none)       the shared tmux session "main"
#                  attach NAME  the tmux session NAME
#                  load         add the private key on stdin to the persistent
#                               agent and store it in Config (ssh BOX load < KEY)
#                  connect DEST ssh -A DEST in a tmux session named for it
#                  register NAME  an ssh Host entry for a yolo sandbox or any
#                               host, from its connection details on stdin, and
#                               recorded in Config (yolo jump BOX connect does both)
#                  anything else, run by sh
#
# Agents: setup starts, as the login user and supervised,
#   - the persistent ssh-agent at $RUN/persist.sock. It is the one agent for
#     logins, tmux panes and held connections. Keys live only in its memory;
#     each start refills it from the keys stored in Config (restore_keys).
#   - a separate ssh-agent at $RUN/thismachine.sock for this machine's own key,
#     used only by ssh on this machine (IdentityAgent), never forwarded. Keys
#     added with a destination restriction (ssh-add -h) sign only when the agent
#     is asked directly, so this one is kept apart from the persistent agent.
# No client's agent is forwarded to the box. login ignores a forwarded
# SSH_AUTH_SOCK and exports the persistent agent's socket to everything it
# starts, so a tmux pane keeps working after the device that started it
# disconnects.
# Config (YOLO_CONFIG_URL, written by init.sh) keeps what must survive a
# restart: the keys (ssh-key-FINGERPRINT, secret) from load, and the
# connections (conn.NAME) from register. Without it, both stay in memory only.
# On Datum, setup writes the box's service-account credentials (from
# YOLO_DATUM_CREDENTIALS_JSON) to $RUN, mode 0600, and points
# YOLO_DATUM_CREDENTIALS at that file.
#
# JUMP_RUN and JUMP_ENV are overridable for tests only.
RUN=${JUMP_RUN:-/run/yolo}
ENVF=${JUMP_ENV:-/etc/agent/env}

setup() {
  export PATH=/bin
  : "${U:?}" "${UID_:?}" "${GID_:?}"
  # The box's own iroh key is the SSH listener's alone. Everything started here
  # (agents, tmux, held connections) must not inherit it: a dumbpipe connect
  # with the listener's key knocks the listener off the relay, and the box
  # becomes unreachable.
  unset IROH_SECRET
  as_user() { /bin/su "$U" -s /bin/sh -c "$1"; }
  # A supervised ssh-agent at $RUN/SOCK, as the user. Each start runs ONSTART
  # (if given) in the background, e.g. to put the stored keys back.
  agent() { # SOCK LABEL [ONSTART]
    (
      while :; do
        rm -f "$RUN/$1"
        [ -n "${3:-}" ] && "$3" &
        as_user "exec /bin/ssh-agent -D -a $RUN/$1 >/dev/null"
        echo "[jump] $2 exited rc=$?; restarting"
        sleep 2
      done
    ) &
  }

  # No core files from the agent or anything else holding keys.
  # shellcheck disable=SC3045  # busybox sh has it
  ulimit -c 0 2>/dev/null

  # Sockets, config and anything key-shaped under $RUN stay in memory, also on
  # a runtime class whose root filesystem is a disk.
  if ! awk -v d="$RUN" '$2 == d && $3 == "tmpfs" { f = 1 } END { exit !f }' /proc/mounts; then
    mkdir -p "$RUN" && mount -t tmpfs -o mode=0700,size=64m tmpfs "$RUN" \
      || echo "[jump] WARNING: $RUN is not in memory (tmpfs mount failed)"
  fi
  chown -R "$UID_:$GID_" "$RUN"
  chmod 700 "$RUN"

  # The Config address. init.sh has written it to the env file for logins; take
  # that line only, since the file also holds the provider keys.
  [ -n "${YOLO_CONFIG_URL:-}" ] || eval "$(sed -n '/^export YOLO_CONFIG_URL=/p' "$ENVF" 2>/dev/null)"
  if [ -n "${YOLO_DATUM_CREDENTIALS_JSON:-}" ]; then
    # The credentials are the box's own service account. The file is created
    # with umask 077 and owned by the login user, so it is never readable by
    # anyone else, not even briefly. Its content is never printed.
    c=$RUN/datum-credentials.json
    rm -f "$c"
    if (umask 077 && printf '%s\n' "$YOLO_DATUM_CREDENTIALS_JSON" > "$c") \
      && chown "$UID_:$GID_" "$c" && chmod 600 "$c"; then
      export YOLO_DATUM_CREDENTIALS="$c"
      printf 'export YOLO_DATUM_CREDENTIALS=%s\n' "$c" >> "$ENVF"
      echo "[jump] datum: credentials for the box's service account are in $RUN"
    else
      echo "[jump] datum: can't write the credentials to $RUN; Config won't work" >&2
    fi
  else
    echo "[jump] no Datum credentials; load and register won't persist"
  fi
  unset YOLO_DATUM_CREDENTIALS_JSON
  [ -n "${YOLO_CONFIG_URL:-}" ] || echo "[jump] no Config (YOLO_CONFIG_URL); keys and connections stay in memory"

  agent persist.sock "persistent agent" restore_keys
  agent thismachine.sock "this machine's agent"
  echo "[jump] persistent agent on $RUN/persist.sock"
  restore_connections &
}

# `yolo cfg list [--secret]` on stdout, retried with backoff (1s to 16s): the
# network may not be up yet at boot.
cfg_list() {
  d=1 n=0
  until out=$(/bin/yolo cfg list "$@"); do
    n=$((n + 1))
    [ "$n" -ge 6 ] && return 1
    sleep "$d"
    d=$((d * 2))
  done
  printf '%s\n' "$out"
}

# The stored keys (ssh-key-* in the box's Secret, written by `load`) into the
# persistent agent, whenever that agent starts. Runs as root: it reads Config
# with the box's credentials, and root may use the user's agent.
restore_keys() {
  [ -n "${YOLO_CONFIG_URL:-}" ] || return 0
  i=0
  until [ -S "$RUN/persist.sock" ] || [ $i -ge 50 ]; do sleep 0.2; i=$((i + 1)); done
  keys=$(cfg_list --secret) || { echo "[jump] can't list the stored keys; none loaded"; return 0; }
  n=0
  for k in $keys; do
    case $k in ssh-key-*) ;; *) continue ;; esac
    if /bin/yolo cfg get --secret "$k" | SSH_AUTH_SOCK=$RUN/persist.sock ssh-add -q - 2>/dev/null; then
      n=$((n + 1))
    else
      echo "[jump] could not load $k"
    fi
  done
  echo "[jump] persistent agent: $n stored key(s) loaded"
}

# Every connection in the box's Config (conn.NAME, written by `register`): its
# ssh Host entry, then a tmux session holding it, as at `connect`.
restore_connections() {
  [ -n "${YOLO_CONFIG_URL:-}" ] || return 0
  names=$(cfg_list) || { echo "[jump] can't list the stored connections; none restored"; return 0; }
  for c in $names; do
    case $c in conn.*) ;; *) continue ;; esac
    name=${c#conn.}
    case $name in ''|-*|*[!A-Za-z0-9._-]*) echo "[jump] skipping $c: bad name"; continue ;; esac
    p=$(/bin/yolo cfg get "$c") || { echo "[jump] can't read $c"; continue; }
    dest=$(printf '%s\n' "$p" | sed -n 's/^dest=//p' | head -1)
    valid_dest "$dest" 2>/dev/null || { echo "[jump] skipping $c: bad dest"; continue; }
    printf '%s\n' "$p" | as_user "JUMP_RUN=$RUN /bin/sh /bin/jump register-local $name" >/dev/null \
      && as_user "JUMP_RUN=$RUN /bin/sh /bin/jump hold $dest" \
      && echo "[jump] reconnecting $name ($dest)"
  done
}

login() {
  # shellcheck disable=SC1090  # the session environment written by init.sh
  [ -r "$ENVF" ] && . "$ENVF"
  # The one agent everything this login starts (tmux panes, yolo, ssh) uses.
  # A forwarded SSH_AUTH_SOCK from the client is ignored.
  SSH_AUTH_SOCK=$RUN/persist.sock
  export SSH_AUTH_SOCK

  case ${SSH_ORIGINAL_COMMAND:-} in
    '')        tmux new-session -A -s main ;;
    "attach "*) tmux new-session -A -s "${SSH_ORIGINAL_COMMAND#attach }" ;;
    load)      load ;;
    "connect "*)  connect "${SSH_ORIGINAL_COMMAND#connect }" ;;
    "register "*) register "${SSH_ORIGINAL_COMMAND#register }" ;;
    *)         /bin/sh -c "$SSH_ORIGINAL_COMMAND" ;;
  esac
  exit $?
}

# `ssh BOX load < KEY`: add the private key on stdin to the persistent agent,
# and store it in Config (ssh-key-FINGERPRINT, secret), from which the agent is
# refilled whenever it or the box restarts. The key passes through this shell's
# memory and, for ssh-keygen, a file on the $RUN tmpfs, removed at once.
# A key with a passphrase can't be loaded this way (no terminal to ask on).
load() {
  k=$(cat)
  if ! printf '%s\n' "$k" | SSH_AUTH_SOCK=$RUN/persist.sock ssh-add -q - 2>/dev/null; then
    echo "jump load: ssh-add refused the key (a passphrase, or not a private key?)" >&2
    return 1
  fi
  # ssh-keygen -l reads a private key only from a file: one on the tmpfs,
  # removed at once.
  kf=$RUN/.key.$$
  (umask 077; printf '%s\n' "$k" > "$kf")
  fp=$(ssh-keygen -l -f "$kf" | awk '{print $2}')
  rm -f "$kf"
  name=ssh-key-$(printf %s "${fp#SHA256:}" | tr '+/' '-_' | tr -d '=')
  if [ -n "${YOLO_CONFIG_URL:-}" ] && printf '%s\n' "$k" | /bin/yolo cfg put --secret "$name"; then
    echo "jump load: stored in Config as $name"
  else
    echo "jump load: in the agent, but NOT stored; it's gone after a restart" >&2
  fi
  SSH_AUTH_SOCK=$RUN/persist.sock ssh-add -l
}

# The tmux session name for a destination: tmux names can't hold . or :.
session_for() { printf %s "$1" | tr '.:@' '___'; }

valid_dest() {
  case $1 in
    ''|-*|*[!A-Za-z0-9@._:%+-]*) echo "jump: bad destination '$1'" >&2; return 2 ;;
  esac
}

# `hold DEST`: a detached tmux session (named for DEST) running hold_loop, so
# the connection outlives every login. Holding an already-held DEST is a no-op.
hold() {
  valid_dest "$1" || return
  s=$(session_for "$1")
  tmux has-session -t "=$s" 2>/dev/null && return 0
  tmux new-session -d -s "$s" env "JUMP_RUN=$RUN" /bin/sh /bin/jump hold-loop "$1"
}

# ssh to DEST, forwarding the persistent agent, and reconnect whenever it drops:
# after the host reboots, after the network goes, after this box restarts (setup
# re-holds every recorded connection). Keepalives notice a dead peer in about
# 30s; retries back off from 5s to 60s, and a connection that lasted a minute
# starts over at 5s. The agent is named explicitly, not taken from SSH_AUTH_SOCK.
# On DEST, ~/.ssh/agent.sock follows the current connection's agent, so what
# runs there keeps a working agent across reconnects.
hold_loop() {
  d=5
  while :; do
    t0=$(date +%s)
    # shellcheck disable=SC2016  # expanded on DEST
    ssh -t -o "IdentityAgent=$RUN/persist.sock" -o "ForwardAgent=$RUN/persist.sock" \
      -o ServerAliveInterval=15 -o ServerAliveCountMax=2 -o ConnectTimeout=20 "$1" \
      'mkdir -p ~/.ssh && ln -sfn "$SSH_AUTH_SOCK" ~/.ssh/agent.sock; exec "${SHELL:-/bin/sh}" -l'
    rc=$?
    [ $(($(date +%s) - t0)) -ge 60 ] && d=5
    echo "[jump] connection to $1 ended (rc=$rc); reconnecting in ${d}s, C-c to stop"
    sleep "$d"
    d=$((d * 2)); [ "$d" -gt 60 ] && d=60
  done
}

# `connect DEST`: hold DEST, then attach to that session. Running it again
# reattaches; detaching (or the device going away) leaves it held.
connect() {
  hold "$1" && tmux attach-session -t "=$(session_for "$1")"
}

# `register NAME`, with a host's connection details on stdin (all public;
# yolo jump BOX connect sends them), one key=value per line:
#   dest=        what to hold: USER@NAME, or NAME
#   alias=       the name its host key is pinned under (HostKeyAlias)
#   hostname=    to reach it directly (DNS name or IP), and port= if not 22
#   ticket=      or to reach it over iroh (a yolo sandbox, or a host running
#                dumbpipe listen-tcp)
#   known_hosts= its host key, "ALIAS TYPE KEY" (repeatable)
#   accept_new=1 no host key given: take the one the host offers now, once
# Writes its ssh Host entry (register_local) and records the details, with
# the host key resolved, as conn.NAME in the box's Config, from which the
# box re-registers and re-holds it after a restart.
register() {
  payload=$(cat)
  if printf '%s\n' "$payload" | grep -qx 'accept_new=1' && ! printf '%s\n' "$payload" | grep -q '^known_hosts='; then
    payload=$(printf '%s\n' "$payload" | accept_new) || return
  fi
  printf '%s\n' "$payload" | register_local "$1" || return
  if [ -n "${YOLO_CONFIG_URL:-}" ] && printf '%s\n' "$payload" | /bin/yolo cfg put "conn.$1"; then
    echo "jump register: recorded conn.$1 in Config"
  else
    echo "jump register: NOT recorded; $1 won't reconnect after a restart" >&2
  fi
}

# Trust on first use: the payload on stdin, minus accept_new, plus the host
# keys the host offers now (ssh-keyscan), under its alias.
accept_new() {
  p=$(cat)
  get() { printf '%s\n' "$p" | sed -n "s/^$1=//p" | head -1; }
  h=$(get hostname) port=$(get port) a=$(get alias)
  [ -n "$h" ] || { echo "jump register: accept_new needs hostname=" >&2; return 2; }
  keys=$(ssh-keyscan -T 10 -p "${port:-22}" -- "$h" 2>/dev/null | awk -v a="$a" '!/^#/ && NF >= 3 { print "known_hosts=" a " " $2 " " $3 }')
  [ -n "$keys" ] || { echo "jump register: no host key from $h" >&2; return 1; }
  echo "jump register: trusting $h's host key on first use:" >&2
  printf '%s\n' "$keys" | sed 's/^known_hosts=[^ ]* /  /' >&2
  printf '%s\n' "$p" | grep -vx 'accept_new=1'
  printf '%s\n' "$keys"
}

# An ssh Host entry NAME, from the details on stdin (see register), with its
# host key pinned. Entries live in ~/.ssh/yolo/, included from ~/.ssh/config.
register_local() {
  case $1 in ''|-*|*[!A-Za-z0-9._-]*) echo "jump register: bad name '$1'" >&2; return 2 ;; esac
  ticket='' alias='' host='' port='' kh=''
  while IFS= read -r line; do
    case $line in
      ticket=*) ticket=${line#ticket=} ;;
      alias=*) alias=${line#alias=} ;;
      hostname=*) host=${line#hostname=} ;;
      port=*) port=${line#port=} ;;
      known_hosts=*) kh="$kh${line#known_hosts=}
" ;;
    esac
  done
  case $alias in ''|-*|*[!A-Za-z0-9._-]*) echo "jump register: bad alias" >&2; return 2 ;; esac
  case $ticket in *[!a-z0-9]*) echo "jump register: bad ticket" >&2; return 2 ;; esac
  case $host in -*|*[!A-Za-z0-9.:-]*) echo "jump register: bad hostname" >&2; return 2 ;; esac
  case $port in *[!0-9]*) echo "jump register: bad port" >&2; return 2 ;; esac
  if [ -z "$ticket" ] && [ -z "$host" ]; then echo "jump register: need ticket= or hostname=" >&2; return 2; fi
  [ -n "$kh" ] || { echo "jump register: no host key (known_hosts=)" >&2; return 2; }
  if printf '%s' "$kh" | grep -v "^$alias [a-z0-9@.-]* [A-Za-z0-9+/=]*\$" | grep -q .; then
    echo "jump register: a known_hosts line isn't 'ALIAS TYPE KEY' for $alias" >&2; return 2
  fi
  d=$HOME/.ssh/yolo
  mkdir -p "$d" && chmod 700 "$HOME/.ssh" "$d"
  printf '%s' "$kh" > "$d/known_hosts.$1"
  {
    echo "Host $1"
    if [ -n "$ticket" ]; then
      echo "  HostName $alias"
      # Never with the box's own iroh key (see setup).
      echo "  ProxyCommand /bin/env -u IROH_SECRET /bin/dumbpipe connect $ticket 2>/dev/null"
    else
      echo "  HostName $host"
      [ -n "$port" ] && echo "  Port $port"
    fi
    echo "  HostKeyAlias $alias"
    echo "  UserKnownHostsFile $d/known_hosts.$1"
    echo "  StrictHostKeyChecking yes"
  } > "$d/$1.conf"
  # Include must come before any Host block to apply everywhere.
  inc='Include ~/.ssh/yolo/*.conf'
  if ! grep -qxF "$inc" "$HOME/.ssh/config" 2>/dev/null; then
    { echo "$inc"; cat "$HOME/.ssh/config" 2>/dev/null; } > "$HOME/.ssh/config.new"
    mv "$HOME/.ssh/config.new" "$HOME/.ssh/config"
  fi
  chmod 600 "$HOME/.ssh/config"
  echo "registered $1 (${ticket:+iroh}${host:+$host${port:+:$port}})"
}

case ${1:-} in
  setup) setup ;;
  login) login ;;
  # Used by setup to restore saved connections, as the login user.
  register-local) register_local "${2:-}" ;;
  hold) hold "${2:-}" ;;
  hold-loop) hold_loop "${2:?}" ;;
  *) echo "usage: jump setup|login" >&2; exit 2 ;;
esac
