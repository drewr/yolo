+
+// rotatedOAuthToken is the token a refresh response leaves behind: the new
+// access token, and the new refresh token when the endpoint rotated it. A
+// response without one means the old refresh token still works.
+func rotatedOAuthToken(old *OAuthToken, tr tokenResponse) *OAuthToken {
+	refresh := old.RefreshToken
+	if tr.RefreshToken != "" {
+		refresh = tr.RefreshToken
+	}
+	return &OAuthToken{AccessToken: tr.AccessToken, RefreshToken: refresh}
+}
