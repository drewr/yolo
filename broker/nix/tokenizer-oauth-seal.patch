+func TestOAuthProcessorConfig_ResponseProcessor_OnlyRefresh(t *testing.T) {
+	_, pub, _ := generateTestSealKey(t)
+	ctx := &SealingContext{AuthConfig: NewBearerAuthConfig("trustno1"), SealKey: pub}
+
+	cfgs := []ResponseProcessorConfig{
+		&OAuthProcessorConfig{&OAuthToken{AccessToken: "access-old", RefreshToken: "refresh-old"}},
+		&OAuthBodyProcessorConfig{Token: &OAuthToken{AccessToken: "access-old", RefreshToken: "refresh-old"}},
+	}
+	for _, cfg := range cfgs {
+		for _, params := range []map[string]string{nil, {ParamSubtoken: SubtokenAccess}} {
+			respProc, err := cfg.ResponseProcessor(params, ctx)
+			assert.NoError(t, err)
+			assert.True(t, respProc == nil, "params %v: access request must not get a response processor", params)
+		}
+
+		_, err := cfg.ResponseProcessor(map[string]string{ParamSubtoken: SubtokenRefresh}, nil)
+		assert.Error(t, err)
+	}
+}
