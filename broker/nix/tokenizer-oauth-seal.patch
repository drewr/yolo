+func TestOAuthProcessorConfig_ResponseProcessor_SealsRefresh(t *testing.T) {
+	_, pub, priv := generateTestSealKey(t)
+
+	authCfg := NewBearerAuthConfig("trustno1")
+	validators := []RequestValidator{AllowHosts("oauth.example.com", "api.example.com")}
+	refreshParams := map[string]string{ParamSubtoken: SubtokenRefresh}
+
+	cases := []struct {
+		name        string
+		cfg         ProcessorConfig
+		placeholder string
+	}{
+		{"header", &OAuthProcessorConfig{&OAuthToken{AccessToken: "access-old", RefreshToken: "refresh-old"}}, ""},
+		{"body", &OAuthBodyProcessorConfig{Token: &OAuthToken{AccessToken: "access-old", RefreshToken: "refresh-old"}, Placeholder: "{{REFRESH}}"}, "{{REFRESH}}"},
+	}
+
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			orig := &Secret{AuthConfig: authCfg, ProcessorConfig: tc.cfg, RequestValidators: validators}
+			ctx := &SealingContext{AuthConfig: authCfg, RequestValidators: validators, SealKey: pub}
+
+			respProc, err := tc.cfg.(ResponseProcessorConfig).ResponseProcessor(refreshParams, ctx)
+			assert.NoError(t, err)
+			assert.NotEqual(t, nil, respProc)
+
+			t.Run("rotated refresh token", func(t *testing.T) {
+				resp := &http.Response{
+					StatusCode: http.StatusOK,
+					Body:       io.NopCloser(strings.NewReader(`{"access_token":"access-new","refresh_token":"refresh-new","expires_in":3600,"token_type":"Bearer"}`)),
+					Header:     make(http.Header),
+				}
+				assert.NoError(t, respProc(resp))
+
+				body, err := io.ReadAll(resp.Body)
+				assert.NoError(t, err)
+				assert.False(t, strings.Contains(string(body), "access-new") || strings.Contains(string(body), "refresh-new"), "cleartext token in response")
+
+				var sealedResp SealedTokenResponse
+				assert.NoError(t, json.Unmarshal(body, &sealedResp))
+				assert.Equal(t, "sealed", sealedResp.TokenType)
+				assert.Equal(t, 3540, sealedResp.ExpiresIn)
+
+				tok, placeholder := sealedOAuth(t, sealedResp.SealedToken, pub, priv)
+				assert.Equal(t, &OAuthToken{AccessToken: "access-new", RefreshToken: "refresh-new"}, tok)
+				assert.Equal(t, tc.placeholder, placeholder)
+
+				got := wireFields(t, orig)
+				sealed, err := unsealSecret(sealedResp.SealedToken, pub, priv)
+				assert.NoError(t, err)
+				gotFields := wireFields(t, sealed)
+				assert.Equal(t, got["bearer_auth"], gotFields["bearer_auth"])
+				assert.Equal(t, []string{"api.example.com", "oauth.example.com"}, sortedHosts(t, gotFields["allowed_hosts"]))
+				assert.Equal(t, sortedHosts(t, got["allowed_hosts"]), sortedHosts(t, gotFields["allowed_hosts"]))
+			})
+
+			t.Run("no rotated refresh token keeps the old one", func(t *testing.T) {
+				resp := &http.Response{
+					StatusCode: http.StatusOK,
+					Body:       io.NopCloser(strings.NewReader(`{"access_token":"access-new","expires_in":60,"token_type":"Bearer"}`)),
+					Header:     make(http.Header),
+				}
+				assert.NoError(t, respProc(resp))
+
+				body, err := io.ReadAll(resp.Body)
+				assert.NoError(t, err)
+				var sealedResp SealedTokenResponse
+				assert.NoError(t, json.Unmarshal(body, &sealedResp))
+				assert.Equal(t, 60, sealedResp.ExpiresIn)
+
+				tok, _ := sealedOAuth(t, sealedResp.SealedToken, pub, priv)
+				assert.Equal(t, &OAuthToken{AccessToken: "access-new", RefreshToken: "refresh-old"}, tok)
+			})
+
+			t.Run("non-2xx passes through", func(t *testing.T) {
+				const errBody = `{"error":"invalid_grant"}`
+				resp := &http.Response{
+					StatusCode: http.StatusBadRequest,
+					Body:       io.NopCloser(strings.NewReader(errBody)),
+					Header:     make(http.Header),
+				}
+				assert.NoError(t, respProc(resp))
+
+				body, err := io.ReadAll(resp.Body)
+				assert.NoError(t, err)
+				assert.Equal(t, errBody, string(body))
+			})
+
+			t.Run("other 2xx is sealed too", func(t *testing.T) {
+				resp := &http.Response{
+					StatusCode: http.StatusCreated,
+					Body:       io.NopCloser(strings.NewReader(`{"access_token":"access-new","token_type":"Bearer"}`)),
+					Header:     make(http.Header),
+				}
+				assert.NoError(t, respProc(resp))
+
+				body, err := io.ReadAll(resp.Body)
+				assert.NoError(t, err)
+				assert.False(t, strings.Contains(string(body), "access-new"), "cleartext token in response")
+			})
+		})
+	}
+}
