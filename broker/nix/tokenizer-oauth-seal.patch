+// sealedOAuth unseals a refresh response's sealed secret and returns the
+// token and placeholder of whichever OAuth processor it holds.
+func sealedOAuth(t *testing.T, sealed string, pub, priv *[32]byte) (*OAuthToken, string) {
+	t.Helper()
+	got, err := unsealSecret(sealed, pub, priv)
+	assert.NoError(t, err)
+
+	switch pc := got.ProcessorConfig.(type) {
+	case *OAuthProcessorConfig:
+		return pc.Token, ""
+	case *OAuthBodyProcessorConfig:
+		return pc.Token, pc.Placeholder
+	}
+	t.Fatalf("unexpected processor %T", got.ProcessorConfig)
+	return nil, ""
+}
+
+// wireFields returns the top-level JSON fields of a secret, so a test can
+// compare what a sealed secret carries over from the original.
+func wireFields(t *testing.T, s *Secret) map[string]json.RawMessage {
+	t.Helper()
+	b, err := json.Marshal(s)
+	assert.NoError(t, err)
+
+	var m map[string]json.RawMessage
+	assert.NoError(t, json.Unmarshal(b, &m))
+	return m
+}
+
+// sortedHosts decodes a secret's allowed_hosts field. The validator lists its
+// hosts in map order, so the order is not compared.
+func sortedHosts(t *testing.T, raw json.RawMessage) []string {
+	t.Helper()
+	var hosts []string
+	assert.NoError(t, json.Unmarshal(raw, &hosts))
+	sort.Strings(hosts)
+	return hosts
+}
